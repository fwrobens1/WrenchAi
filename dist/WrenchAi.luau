__modules["llm/client"] = function()
local HttpService = game:GetService("HttpService")
local Compat = __require("compat")
local Util = __require("util")

local Client = {}
Client.__index = Client

local function trimBase(url)
    local text = Util.Trim(url)
    while #text > 0 and text:sub(-1) == "/" do
        text = text:sub(1, -2)
    end
    return text
end

local function parseErrorBody(raw)
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if ok and type(decoded) == "table" then
        local err = decoded.error
        if type(err) == "table" then
            return tostring(err.message or err.code or "API error")
        end
        if type(err) == "string" then
            return err
        end
        if decoded.message then
            return tostring(decoded.message)
        end
    end
    return Util.Truncate(raw or "", 400)
end

function Client.new(config)
    return setmetatable({ config = config }, Client)
end

function Client:Url()
    return trimBase(self.config.baseURL or "") .. "/chat/completions"
end

function Client:Chat(messages, tools, isCancelled)
    if type(self.config.apiKey) ~= "string" or Util.Trim(self.config.apiKey) == "" then
        return nil, {
            kind = "auth",
            message = "No API key configured. Open Settings (CFG) and paste your API key.",
            status = 0,
        }, 0
    end

    local body = {
        model = self.config.model,
        messages = messages,
        temperature = tonumber(self.config.temperature) or 0.7,
        max_tokens = tonumber(self.config.maxTokens) or 16000,
    }
    if tools and #tools > 0 then
        body.tools = tools
        body.tool_choice = "auto"
    end

    local encodeOk, encoded = pcall(function()
        return HttpService:JSONEncode(body)
    end)
    if not encodeOk then
        return nil, { kind = "encode", message = "Could not encode the request.", status = 0 }, 0
    end

    local headers = {
        ["Content-Type"] = "application/json",
        ["Accept"] = "application/json",
        ["Authorization"] = "Bearer " .. Util.Trim(self.config.apiKey),
    }

    local lastError = nil
    for attempt = 1, 3 do
        if isCancelled and isCancelled() then
            return nil, { kind = "cancelled", message = "Cancelled.", status = 0 }, 0
        end

        local started = os.clock()
        local response, requestError = Compat.Http({
            Url = self:Url(),
            Method = "POST",
            Headers = headers,
            Body = encoded,
        })

        if not response then
            lastError = { kind = "network", message = tostring(requestError), status = 0 }
        else
            local status = response.status
            local raw = response.body or ""
            if status == 200 or status == 0 then
                local decodeOk, decoded = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)
                if decodeOk and type(decoded) == "table" then
                    return {
                        data = decoded,
                        elapsed = os.clock() - started,
                        attempts = attempt,
                    }, nil, status
                end
                -- Some gateways stream SSE even when stream=false. Use the last data frame.
                local lastFrame = nil
                for line in raw:gmatch("[^\r\n]+") do
                    local payload = line:match("^data:%s*(.+)$")
                    if payload and payload ~= "[DONE]" then
                        lastFrame = payload
                    end
                end
                if lastFrame then
                    local frameOk, frame = pcall(function()
                        return HttpService:JSONDecode(lastFrame)
                    end)
                    if frameOk and type(frame) == "table" then
                        return {
                            data = frame,
                            elapsed = os.clock() - started,
                            attempts = attempt,
                        }, nil, status
                    end
                end
                lastError = {
                    kind = "decode",
                    message = "Endpoint returned non-JSON content: " .. Util.Truncate(raw, 300),
                    status = status,
                    raw = raw,
                }
            else
                local message = parseErrorBody(raw)
                lastError = {
                    kind = "http",
                    message = "HTTP " .. tostring(status) .. ": " .. message,
                    status = status,
                    raw = raw,
                }
                if status ~= 429 and status < 500 then
                    return nil, lastError, status
                end
            end
        end

        if attempt < 3 then
            task.wait(2 ^ (attempt - 1))
        end
    end

    return nil, lastError, lastError and lastError.status or 0
end

return Client

end
__modules["main"] = function()
local Players = game:GetService("Players")
local Compat = __require("compat")
local Config = __require("config")
local UI = __require("ui/window")
local Tools = __require("tools/init")
local Loop = __require("agent/loop")
local Chats = __require("agent/chats")
local Util = __require("util")

local environment = Compat.Environment

local function guiParents()
    local parents = {}
    local function add(parent)
        if parent then
            table.insert(parents, parent)
        end
    end
    local gethui = Compat.Lookup("gethui")
    if type(gethui) == "function" then
        local ok, parent = pcall(gethui)
        if ok then
            add(parent)
        end
    end
    add(Players.LocalPlayer:FindFirstChild("PlayerGui"))
    local ok, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok then
        add(coreGui)
    end
    return parents
end

local function destroyLeftoverGuis()
    for _, parent in ipairs(guiParents()) do
        local ok, children = pcall(function()
            return parent:GetChildren()
        end)
        if ok and type(children) == "table" then
            for _, child in ipairs(children) do
                local nameOk, name = pcall(function()
                    return child.Name
                end)
                if nameOk and name == "WrenchAi" then
                    pcall(function()
                        child:Destroy()
                    end)
                end
            end
        end
    end
end

local function unloadPrevious()
    local previous = environment.WrenchAi
    if type(previous) == "table" then
        if type(previous.unload) == "function" then
            pcall(previous.unload)
        end
        if previous.loop and type(previous.loop.Cancel) == "function" then
            pcall(function()
                previous.loop:Cancel()
            end)
        end
        if previous.ui and type(previous.ui.Destroy) == "function" then
            pcall(function()
                previous.ui:Destroy()
            end)
        end
    end
    environment.WrenchAi = nil
    destroyLeftoverGuis()
end

unloadPrevious()

local config = Config.Load()
local ui = UI.new({ config = config, compat = Compat, callbacks = {} })

local ctx = {
    config = config,
    compat = Compat,
    ui = ui,
    scriptCache = {},
    scriptIndex = nil,
    dexSource = nil,
}

local tools = Tools.new(ctx)
local chats = Chats.Load()
local currentId = nil

local loop
loop = Loop.new({
    ui = ui,
    tools = tools,
    config = config,
    compat = Compat,
    onDone = function()
        local chat = nil
        for _, entry in ipairs(chats) do
            if entry.id == currentId then
                chat = entry
                break
            end
        end
        if chat then
            chat.messages = loop:GetMessages()
            chat.preview = Chats.PreviewOf(chat.messages)
            Chats.Save(chats)
            ui:RenderSessions(chats, currentId)
        end
    end,
})

local function persistChats()
    Chats.Save(chats)
    ui:RenderSessions(chats, currentId)
end

local function findChat(id)
    for _, entry in ipairs(chats) do
        if entry.id == id then
            return entry
        end
    end
    return nil
end

local function ensureChat(text)
    if currentId ~= nil then
        return
    end
    local chat = {
        id = Chats.NewId(),
        title = Chats.TitleOf(text),
        createdAt = os.time(),
        preview = "",
        messages = {},
    }
    table.insert(chats, 1, chat)
    while #chats > Chats.MaxChats do
        table.remove(chats)
    end
    currentId = chat.id
end

local function replayChat(messages)
    local start = math.max(1, #messages - 60)
    for index = start, #messages do
        local message = messages[index]
        if message.role == "user" then
            local text = tostring(message.content or "")
            if text:sub(1, 13) ~= "[TOOL RESULT:" then
                ui:AddMessage("user", text)
            end
        elseif message.role == "assistant" then
            local text = tostring(message.content or "")
            if Util.Trim(text) ~= "" and not Chats.IsProtocolJson(text) then
                ui:AddMessage("assistant", text)
            end
        end
    end
end

ctx.isCancelled = function()
    return loop:IsCancelled()
end

ctx.approve = function(spec)
    return ui:AskApproval(spec, ctx.isCancelled)
end

ctx.setAutoApprove = function(value)
    local enabled = value == true
    ctx.config.autoApproveScripts = enabled
    if ui.pendingAutoApprove ~= enabled then
        ui.pendingAutoApprove = enabled
        ui:UpdateAutoApproveLabel()
    end
    Config.Save(ctx.config)
end

ui.callbacks.onSend = function(text)
    if Util.Trim(ctx.config.apiKey or "") == "" then
        ui:AddError("No API key yet. Open Settings and paste the key for " .. tostring(ctx.config.baseURL) .. ".")
        ui:OpenSettings()
        return
    end
    ensureChat(text)
    loop:Send(text)
end

ui.callbacks.onStop = function()
    loop:Cancel()
end

ui.callbacks.onNewChat = function()
    if loop.running then
        return
    end
    loop:Reset()
    ui:ClearMessages()
    ui:SetStatus("Ready")
    currentId = nil
    ui:RenderSessions(chats, nil)
end

ui.callbacks.onSwitchChat = function(id)
    if loop.running or id == currentId then
        return
    end
    local target = findChat(id)
    if not target then
        return
    end
    local previous = findChat(currentId)
    if previous then
        previous.messages = loop:GetMessages()
        previous.preview = Chats.PreviewOf(previous.messages)
    end
    currentId = id
    loop:SetMessages(target.messages or {})
    ui:ClearMessages()
    replayChat(target.messages or {})
