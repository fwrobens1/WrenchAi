                return button:IsA("GuiButton")
            end)
            if not classOk or not isButton then
                return { ok = false, error = "That instance is a " .. button.ClassName .. ", not a GuiButton." }
            end
            local action = args.action
            if action and not table.find(SIGNALS, action) then
                return { ok = false, error = "action must be one of: " .. table.concat(SIGNALS, ", ") }
            end

            local firesignal = ctx.compat.Lookup("firesignal")
            if type(firesignal) == "function" then
                if action then
                    local ok, errorMessage = pcall(firesignal, button[action])
                    if not ok then
                        return { ok = false, error = "firesignal failed: " .. tostring(errorMessage) }
                    end
                else
                    local fired = 0
                    for _, name in ipairs(SIGNALS) do
                        local ok = pcall(firesignal, button[name])
                        if ok then
                            fired += 1
                        end
                    end
                    if fired == 0 then
                        return { ok = false, error = "firesignal failed for every button signal." }
                    end
                end
                return {
                    ok = true,
                    data = { path = button:GetFullName(), method = "firesignal", action = action or "all signals" },
                }
            end

            local virtualInput = getVirtualInputManager()
            if not virtualInput then
                return {
                    ok = false,
                    error = "This executor has neither firesignal nor a usable VirtualInputManager.",
                }
            end
            if not button.Visible or button.AbsoluteSize.X <= 0 or button.AbsoluteSize.Y <= 0 then
                return { ok = false, error = "Virtual mouse clicking needs a visible button with a nonzero size." }
            end
            if action and action ~= "Activated" and action ~= "MouseButton1Click" and action ~= "MouseButton2Click" then
                return { ok = false, error = "Down-only signals require firesignal." }
            end

            local center = button.AbsolutePosition + button.AbsoluteSize / 2
            local inset = GuiService:GetGuiInset()
            local x, y = center.X + inset.X, center.Y + inset.Y
            local mouseButton = action == "MouseButton2Click" and 1 or 0
            virtualInput:SendMouseMoveEvent(x, y, game)
            task.wait()
            virtualInput:SendMouseButtonEvent(x, y, mouseButton, true, game, 0)
            task.wait(0.05)
            virtualInput:SendMouseButtonEvent(x, y, mouseButton, false, game, 0)
            return {
                ok = true,
                data = {
                    path = button:GetFullName(),
                    method = "virtual-input",
                    note = "The button must be visible and unobstructed.",
                },
            }
        end,
    },
    {
        name = "type_text",
        description = "Set text on a TextBox and optionally focus/leave it. useKeyPress simulates typing when the executor supports it.",
        parameters = {
            type = "object",
            properties = {
                path = Shared.StringProperty("Full path of the TextBox.", nil),
                text = Shared.StringProperty("Text to enter.", nil),
                enter = Shared.BoolProperty("Release focus as if Enter was pressed.", false),
                useKeyPress = Shared.BoolProperty("Simulate per-character input instead of setting Text.", false),
            },
            required = { "path", "text" },
        },
        run = function(args, ctx)
            local textBox, pathError = resolveGui(args.path)
            if not textBox then
                return { ok = false, error = pathError }
            end
            local classOk, isTextBox = pcall(function()
                return textBox:IsA("TextBox")
            end)
            if not classOk or not isTextBox then
                return { ok = false, error = "That instance is a " .. textBox.ClassName .. ", not a TextBox." }
            end
            local text = tostring(args.text or "")
            textBox:CaptureFocus()
            task.wait(0.05)

            if args.useKeyPress then
                local virtualInput = getVirtualInputManager()
                local keypress = ctx.compat.Lookup("keypress")
                if virtualInput then
                    for index = 1, #text do
                        virtualInput:SendTextInput(text:sub(index, index), nil, game)
                        task.wait(0.01)
                    end
                elseif type(keypress) == "function" then
                    local keyrelease = ctx.compat.Lookup("keyrelease")
                    for index = 1, #text do
                        local byte = text:sub(index, index):upper():byte()
                        if byte then
                            keypress(byte)
                            task.wait(0.01)
                            if type(keyrelease) == "function" then
                                keyrelease(byte)
                            end
                        end
                    end
                else
                    textBox:ReleaseFocus(false)
                    return {
                        ok = false,
                        error = "This executor cannot simulate key input; call again with useKeyPress=false.",
                    }
                end
            else
                textBox.Text = text
            end

            textBox:ReleaseFocus(args.enter == true)
            return {
                ok = true,
                data = { path = textBox:GetFullName(), length = #text, method = args.useKeyPress and "keypress" or "direct" },
            }
        end,
    },
}

end
__modules["tools/init"] = function()
local SpyManager = __require("tools/spymanager")
local Util = __require("util")

local Tools = {}
Tools.__index = Tools

function Tools.new(ctx)
    local self = setmetatable({ ctx = ctx, entries = {}, order = {} }, Tools)
    self.ctx.spy = SpyManager.new(self.ctx)

    local modules = {
        __require("tools/inspect"),
        __require("tools/scripts"),
        __require("tools/run"),
        __require("tools/gui"),
        __require("tools/spy"),
        __require("tools/dex"),
    }
    for _, definitions in ipairs(modules) do
        for _, entry in ipairs(definitions) do
            self:Register(entry)
        end
    end
    return self
end

function Tools:Register(entry)
    assert(type(entry.name) == "string" and entry.name ~= "", "tool name is required")
    assert(type(entry.run) == "function", "tool " .. entry.name .. " needs a run function")
    self.entries[entry.name] = entry
    table.insert(self.order, entry.name)
end

function Tools:Has(name)
    return self.entries[name] ~= nil
end

function Tools:Schemas()
    local schemas = {}
    for _, name in ipairs(self.order) do
        local entry = self.entries[name]
        table.insert(schemas, {
            type = "function",
            ["function"] = {
                name = name,
                description = entry.description,
                parameters = entry.parameters
                    or { type = "object", properties = {} },
            },
        })
    end
    return schemas
end

function Tools:PromptCatalog()
    local lines = { "Available tools. Call one at a time with a single JSON object." }
    for _, name in ipairs(self.order) do
        local entry = self.entries[name]
        local arguments = {}
        if entry.parameters and entry.parameters.properties then
            for key in pairs(entry.parameters.properties) do
                table.insert(arguments, key)
            end
            table.sort(arguments)
        end
        table.insert(lines, "- " .. name .. "(" .. table.concat(arguments, ", ") .. "): " .. entry.description)
    end
    return table.concat(lines, "\n")
end

function Tools:Call(name, args)
    local entry = self.entries[name]
    if not entry then
        return { ok = false, error = "Unknown tool: " .. tostring(name) }
    end
    if type(args) ~= "table" then
        args = {}
    end
    local ok, result = pcall(entry.run, args, self.ctx)
    if not ok then
        return { ok = false, error = Util.ErrorText(result) }
    end
    if type(result) ~= "table" then
        return { ok = true, data = result }
    end
    if result.ok == nil then
        return { ok = true, data = result }
    end
    return result
end

return Tools

end
__modules["tools/inspect"] = function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local LogService = game:GetService("LogService")
local Serialize = __require("serialize")
local Shared = __require("tools/shared")
local Util = __require("util")

local function matchSelector(instance, selector)
    local lowered = string.lower(selector)
    if lowered:sub(1, 1) == "#" then
        return string.lower(instance.Name) == lowered:sub(2)
    end
    if lowered:sub(1, 1) == "." then
        return string.lower(instance.ClassName) == lowered:sub(2)
    end
    if string.lower(instance.ClassName) == lowered or string.lower(instance.Name) == lowered then
        return true
    end
    return string.find(string.lower(instance.Name), lowered, 1, true) ~= nil
end

local function searchFallback(root, selector, limit)
    local results = {}
    local visited = 0
    local queue = { root }
    local head = 1
    while head <= #queue and #results < limit and visited < 6000 do
        local current = queue[head]
        head += 1
        local ok, children = pcall(function()
            return current:GetChildren()
        end)
        if ok then
            for _, child in ipairs(children) do
                visited += 1
                if matchSelector(child, selector) then
                    table.insert(results, child)
                    if #results >= limit then
                        break
                    end
                end
                table.insert(queue, child)
                if visited >= 6000 then
                    break
                end
            end
        end
    end
    return results, visited
end

local PROPERTY_GROUPS = {
    "Name", "ClassName", "Parent", "Archivable", "Attributes", "Tags",
    "Visible", "Enabled", "Text", "TextColor3", "TextSize", "Font", "PlaceholderText",
    "BackgroundColor3", "BackgroundTransparency", "Image", "ImageColor3", "ImageTransparency",
    "Size", "Position", "AnchorPoint", "ZIndex", "LayoutOrder", "AbsoluteSize", "AbsolutePosition",
    "Rotation", "BorderSizePixel", "TextWrapped", "TextScaled", "RichText", "AutoButtonColor",
    "Position", "Orientation", "CFrame", "Anchored", "CanCollide", "CanTouch", "CanQuery",
    "Transparency", "Color", "Material", "Massless", "AssemblyLinearVelocity", "AssemblyAngularVelocity",
    "Value", "Health", "MaxHealth", "WalkSpeed", "JumpPower", "JumpHeight", "HipHeight",
    "Brightness", "Range", "Shadows", "Volume", "SoundId", "Playing", "Looped",
    "Disabled", "RunContext", "MaxPlayers", "DisplayName", "UserId", "Character",
}

local function getPropertyList(instance, requested)
    if type(requested) == "table" and #requested > 0 then
        return requested
    end
    local names = {}
    local seen = {}
    for _, name in ipairs(PROPERTY_GROUPS) do
        if not seen[name] then
            seen[name] = true
            table.insert(names, name)
        end
    end
    return names
end

local function readProperties(instance, requested)
    local properties = {}
    local names = getPropertyList(instance, requested)
    local truncated = false
    if #names > 60 then
        truncated = true
        names = { table.unpack(names, 1, 60) }
    end
    for _, name in ipairs(names) do
        if name ~= "Source" then
            local ok, value = pcall(function()
                return instance[name]
            end)
            if ok and value ~= nil then
                properties[name] = Serialize.Value(value, 3)
            end
        end
    end
    local attributes = nil
    pcall(function()
        attributes = instance:GetAttributes()
    end)
    local tags = nil
    pcall(function()
        tags = instance:GetTags()
    end)
    return properties, attributes, tags, truncated
end

return {
    {
        name = "get_game_info",
        description = "Return place, job, player, platform, executor name/version, and available executor capabilities.",
        parameters = {
            type = "object",
            properties = {
                includePlaceName = Shared.BoolProperty("Fetch the place name and creator from MarketplaceService.", false),
            },
        },
        run = function(args, ctx)
            local localPlayer = Players.LocalPlayer
            local player = nil
            if localPlayer then
                player = {
                    name = localPlayer.Name,
                    displayName = localPlayer.DisplayName,
                    userId = localPlayer.UserId,
                    character = localPlayer.Character and localPlayer.Character:GetFullName() or nil,
                }
            end
            local info = {
                placeId = game.PlaceId,
                gameId = game.GameId,
                jobId = game.JobId,
                placeVersion = game.PlaceVersion,
                player = player,
                platform = UserInputService.TouchEnabled and "mobile" or "desktop",
                studio = RunService:IsStudio(),
                maxPlayers = Players.MaxPlayers,
                executor = ctx.compat.Diagnostics(),
            }
            if args.includePlaceName then
                local ok, product = pcall(function()
                    return MarketplaceService:GetProductInfo(game.PlaceId)
                end)
                if ok and type(product) == "table" then
                    info.placeName = product.Name
                    info.creator = product.Creator and product.Creator.Name or nil
                    info.creatorType = product.Creator and tostring(product.Creator.CreatorType) or nil
                end
            end
            return { ok = true, data = info }
        end,
    },
    {
        name = "search_instances",
        description = "Find instances under a root using a Roblox selector (ClassName, #Name, .ClassName) or a name/class substring.",
        parameters = {
            type = "object",
            properties = {
                root = Shared.StringProperty("Root path, for example game.Workspace or Players.LocalPlayer.PlayerGui.", "game"),
                selector = Shared.StringProperty("Selector or name/class substring.", nil),
                limit = Shared.IntProperty("Maximum results.", 30, 1, 100),
            },
            required = { "selector" },
        },
        run = function(args, ctx)
            local selector = Util.Trim(args.selector or "")
            if selector == "" then
                return { ok = false, error = "selector is required." }
            end
            local root, rootError = Shared.ResolvePath(args.root or "game")
            if not root then
                return { ok = false, error = rootError }
            end
            local limit = Util.Clamp(tonumber(args.limit) or 30, 1, 100)
            local matches = nil
            local usedFallback = false
            if type(root.QueryDescendants) == "function" then
                local ok, result = pcall(function()
                    return root:QueryDescendants(selector)
                end)
                if ok and type(result) == "table" and #result > 0 then
                    matches = result
                end
            end
            if not matches then
                usedFallback = true
                matches = searchFallback(root, selector, limit)
            end

            local results = {}
            for index = 1, math.min(#matches, limit) do
                table.insert(results, Shared.Describe(matches[index]))
            end
            return {
                ok = true,
                data = {
                    root = root:GetFullName(),
                    selector = selector,
                    count = #matches,
                    returned = #results,
                    truncated = #matches > limit,
                    fallback = usedFallback,
                    results = results,
                },
            }
        end,
    },
    {
        name = "get_descendants_tree",
        description = "Return a bounded hierarchy under a root with depth and children limits. Use summaryOnly for class counts.",
        parameters = {
            type = "object",
            properties = {
                root = Shared.StringProperty("Root path.", "game"),
                maxDepth = Shared.IntProperty("How many levels below the root to visit.", 2, 0, 5),
                maxChildren = Shared.IntProperty("Maximum children per instance.", 20, 1, 40),
                classFilter = Shared.StringProperty("Only report instances that IsA this class.", ""),
                summaryOnly = Shared.BoolProperty("Return only class counts.", false),
            },
        },
        run = function(args, ctx)
            local root, rootError = Shared.ResolvePath(args.root or "game")
            if not root then
                return { ok = false, error = rootError }
            end
            local maxDepth = Util.Clamp(tonumber(args.maxDepth) or 2, 0, 5)
            local maxChildren = Util.Clamp(tonumber(args.maxChildren) or 20, 1, 40)
            local classFilter = Util.Trim(args.classFilter or "")
            local summaryOnly = args.summaryOnly == true
            local budget = 300
            local visited = 0
            local truncated = false
            local nodes = {}
            local classCounts = {}

            if classFilter ~= "" then
                local ok, isA = pcall(function()
                    return root:IsA(classFilter)
                end)
                if not ok then
                    return { ok = false, error = "Invalid classFilter: " .. classFilter }
                end
            end

            local function walk(instance, depth)
                if depth > maxDepth or visited >= budget then
                    return
                end
                local ok, children = pcall(function()
                    return instance:GetChildren()
                end)
                if not ok then
                    return
                end
                for index, child in ipairs(children) do
                    if index > maxChildren then
                        truncated = true
                        break
                    end
                    local matches = true
                    if classFilter ~= "" then
                        local matchOk, isA = pcall(function()
                            return child:IsA(classFilter)
                        end)
                        matches = matchOk and isA
                    end
                    if matches then
                        visited += 1
                        if visited > budget then
                            truncated = true
                            return
                        end
                        classCounts[child.ClassName] = (classCounts[child.ClassName] or 0) + 1
                        if not summaryOnly then
                            table.insert(nodes, {
                                path = child:GetFullName(),
                                class = child.ClassName,
                                depth = depth,
                            })
                        end
                    end
                    if depth < maxDepth then
                        walk(child, depth + 1)
                    end
                    if visited >= budget then
                        truncated = true
                        return
                    end
                end
            end

            walk(root, 1)
            local data = {
                root = root:GetFullName(),
                visited = visited,
                truncated = truncated,
                classCounts = classCounts,
            }
            if not summaryOnly then
                data.nodes = nodes
            end
            return { ok = true, data = data }
        end,
    },
    {
        name = "get_properties",
        description = "Read serializable properties, attributes, and tags from one instance. Use read_script for script source.",
        parameters = {
            type = "object",
            properties = {
                path = Shared.StringProperty("Instance path.", nil),
                properties = Shared.ArrayProperty("Optional list of property names to read.", "string"),
            },
            required = { "path" },
        },
        run = function(args, ctx)
            local instance, pathError = Shared.ResolvePath(args.path or "")
            if not instance then
                return { ok = false, error = pathError }
            end
            local properties, attributes, tags, truncated = readProperties(instance, args.properties)
            return {
                ok = true,
                data = {
                    path = instance:GetFullName(),
                    class = instance.ClassName,
                    properties = properties,
                    attributes = attributes,
                    tags = tags,
                    truncated = truncated,
                },
            }
        end,
    },
    {
        name = "get_console_logs",
        description = "Return recent Roblox client console log lines, optionally filtered by a substring.",
        parameters = {
            type = "object",
            properties = {
                limit = Shared.IntProperty("Number of lines to return.", 40, 1, 200),
                filter = Shared.StringProperty("Only return lines containing this substring.", ""),
            },
        },
        run = function(args, ctx)
            local limit = Util.Clamp(tonumber(args.limit) or 40, 1, 200)
            local filter = Util.Trim(args.filter or "")
            local ok, history = pcall(function()
                return LogService:GetLogHistory()
            end)
            if not ok or type(history) ~= "table" then
                return { ok = false, error = "LogService:GetLogHistory is unavailable on this executor." }
            end
            local entries = {}
            for index = #history, 1, -1 do
                local entry = history[index]
                local message = tostring(entry.message or "")
                if filter == "" or string.find(string.lower(message), string.lower(filter), 1, true) then
                    table.insert(entries, {
                        message = Util.Truncate(message, 500),
                        kind = tostring(entry.messageType),
                        timestamp = entry.timestamp,
                    })
                    if #entries >= limit then
                        break
                    end
                end
            end
            return {
                ok = true,
                data = {
                    count = #entries,
                    totalHistory = #history,
                    filter = filter,
                    entries = entries,
                },
            }
        end,
    },
}

end
__modules["tools/run"] = function()
local Serialize = __require("serialize")
local Shared = __require("tools/shared")
local Util = __require("util")

return {
    {
        name = "run_luau",
        description = "Execute Luau in the executor. The user approves each script unless always-allow is on. Return a compact value; print output is captured.",
        parameters = {
            type = "object",
            properties = {
                code = Shared.StringProperty("Luau source to execute.", nil),
                description = Shared.StringProperty("Short explanation shown in the approval prompt.", ""),
            },
            required = { "code" },
        },
        run = function(args, ctx)
            local code = args.code
            if type(code) ~= "string" or Util.Trim(code) == "" then
                return { ok = false, error = "code is required." }
            end

            if not ctx.config.autoApproveScripts then
                if type(ctx.approve) ~= "function" then
                    return { ok = false, error = "No approval handler is available, so script execution was refused." }
                end
                local allowed, always = ctx.approve({
                    kind = "script",
                    title = "Run Luau",
                    description = args.description or "The agent wants to execute this code in your client.",
                    code = code,
                })
                if not allowed then
                    return { ok = false, error = "The user denied this script." }
                end
                if always and type(ctx.setAutoApprove) == "function" then
                    ctx.setAutoApprove(true)
                end
            end

            local loadstringFunction = ctx.compat.Lookup("loadstring")
            if type(loadstringFunction) ~= "function" then
                return { ok = false, error = "This executor has no loadstring." }
            end
            local chunk, compileError = loadstringFunction(code)
            if not chunk then
                return { ok = false, error = "Compile error: " .. tostring(compileError) }
            end

            ctx.compat.SetIdentity(8)
            local environment = ctx.compat.Environment
            local environmentPrint = environment.print
            local globalPrint = type(_G) == "table" and _G.print or nil
            local logs = {}
            local capturedPrint = function(...)
                local parts = {}
                for index = 1, select("#", ...) do
                    parts[#parts + 1] = tostring(select(index, ...))
                end
                if #logs < 200 then
                    table.insert(logs, table.concat(parts, " "))
                end
                if type(environmentPrint) == "function" then
                    pcall(environmentPrint, ...)
                elseif type(globalPrint) == "function" then
                    pcall(globalPrint, ...)
                end
            end

            pcall(function()
                environment.print = capturedPrint
            end)
            if type(_G) == "table" and _G ~= environment then
                pcall(function()
                    _G.print = capturedPrint
                end)
            end

            local started = os.clock()
            local succeeded, result = xpcall(chunk, function(err)
                local traceOk, trace = pcall(debug.traceback, tostring(err), 2)
                return traceOk and trace or tostring(err)
            end)
            local duration = os.clock() - started

            pcall(function()
                environment.print = environmentPrint
            end)
            if type(_G) == "table" and _G ~= environment then
                pcall(function()
                    _G.print = globalPrint
                end)
            end

            local data = {
                duration = duration,
                logs = Util.Truncate(table.concat(logs, "\n"), 6000),
            }

            if succeeded then
                if result ~= nil then
                    data.returned = Serialize.Value(result, 4)
                elseif #logs == 0 then
                    data.note = "The chunk returned no value and printed nothing. Return a value when you need results."
                end
                return { ok = true, data = data }
            end

            data.error = Util.Truncate(tostring(result), 4000)
            return { ok = false, error = data.error, data = data }
        end,
    },
}

end
__modules["tools/scripts"] = function()
local Serialize = __require("serialize")
local Shared = __require("tools/shared")
local Util = __require("util")

local CACHE_LIMIT = 48
local DECOMPILE_TIMEOUT = 8
local GREP_TIME_BUDGET = 25

local function decompileWithTimeout(script, ctx)
    local finished = false
    local source = nil
    local failure = nil
    task.spawn(function()
        local ok, result, err = pcall(function()
            return ctx.compat.Decompile(script)
        end)
        if ok then
            source = result
            failure = err
        else
            failure = result
        end
        finished = true
    end)
    local deadline = os.clock() + DECOMPILE_TIMEOUT
    while not finished and os.clock() < deadline do
        task.wait(0.05)
    end
    if not finished then
        return nil, "The decompiler did not finish within " .. tostring(DECOMPILE_TIMEOUT) .. "s."
    end
    if type(source) == "string" and #source > 0 then
        return source
    end
    return nil, failure or "The decompiler returned no source."
end

local function getSource(script, ctx)
    local debugId = nil
    pcall(function()
        debugId = script:GetDebugId()
    end)
    local key = debugId or tostring(script)
    local cache = ctx.scriptCache
    local cached = cache[key]
    if cached then
        return cached.source, cached.lines, cached.debugId
    end

    local source, errorMessage = decompileWithTimeout(script, ctx)
    if not source then
        return nil, errorMessage
    end
    source = Shared.StripBanner(source)
    local lines = Util.Lines(source)

    local count = 0
    local oldestKey = nil
    local oldestAt = math.huge
    for cacheKey, entry in pairs(cache) do
        count += 1
        if entry.at < oldestAt then
            oldestAt = entry.at
            oldestKey = cacheKey
        end
    end
    if count >= CACHE_LIMIT and oldestKey then
        cache[oldestKey] = nil
    end
    cache[key] = { source = source, lines = lines, at = os.clock(), debugId = debugId }
    return source, lines, debugId
end

local function indexScripts(ctx, scripts)
    local index = ctx.scriptIndex or { byDebugId = {}, scripts = {} }
    for _, script in ipairs(scripts) do
        local debugId = nil
        pcall(function()
            debugId = script:GetDebugId()
        end)
        if debugId and not index.byDebugId[debugId] then
            index.byDebugId[debugId] = script
        end
    end
    ctx.scriptIndex = index
end

return {
    {
        name = "list_scripts",
        description = "List loaded LuaSourceContainer scripts with paths and debugIds. Use debugId with read_script.",
        parameters = {
            type = "object",
            properties = {
                root = Shared.StringProperty("Root path to scan.", "game"),
                query = Shared.StringProperty("Substring matched against path, name, and class.", ""),
                classFilter = Shared.StringProperty("Limit to LocalScript, ModuleScript, or Script.", ""),
                includeDetached = Shared.BoolProperty("Include scripts detached from the DataModel.", false),
                limit = Shared.IntProperty("Maximum scripts to return.", 80, 1, 200),
            },
        },
        run = function(args, ctx)
            local root, rootError = Shared.ResolvePath(args.root or "game")
            if not root then
                return { ok = false, error = rootError }
            end
            local query = string.lower(Util.Trim(args.query or ""))
            local classFilter = Util.Trim(args.classFilter or "")
            local limit = Util.Clamp(tonumber(args.limit) or 80, 1, 200)
