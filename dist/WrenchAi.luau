            local totalLines = #lines
            local startLine = Util.Clamp(tonumber(args.startLine) or 1, 1, math.max(1, totalLines))
            local endLine = Util.Clamp(tonumber(args.endLine) or totalLines, startLine, math.max(1, totalLines))
