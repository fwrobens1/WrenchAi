function UI:AskApproval(spec, isCancelled)
    local state = { done = false, allow = false, always = false }
    self.pendingApproval = state

    if not self.root.Visible then
        self:Show()
    end

    local row = self:NewRow()
    local card = create("Frame", {
        BackgroundColor3 = Theme.surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, row)
    withCorner(card, 14)
    withStroke(card, Theme.warn, 1, 0.5)
    withPadding(card, 12, 14, 12, 14)
    withList(card, 8)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 12),
        Font = Theme.fontBold,
        TextSize = 8,
        TextColor3 = Theme.warn,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "PERMISSION REQUIRED",
    }, card)

    local title = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Theme.fontMedium,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LineHeight = 1.25,
        Text = tostring(spec.description or spec.title or "Run this code?"),
    }, card)

    local codeScroll = create("ScrollingFrame", {
        BackgroundColor3 = Theme.code,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 132),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.line,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, card)
    withCorner(codeScroll, 10)
    withPadding(codeScroll, 8, 10, 8, 10)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Theme.fontCode,
        TextSize = 10,
        TextColor3 = Theme.text,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LineHeight = 1.1,
        Text = tostring(spec.code or ""),
    }, codeScroll)

    local buttons = create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
    }, card)
    withList(buttons, 6, true)

    local function decisionButton(text, color, textColor, width, order, callback)
        local button = create("TextButton", {
            Size = UDim2.new(width, -4, 1, 0),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Text = text,
            Font = Theme.fontBold,
            TextSize = 11,
            TextColor3 = textColor,
            AutoButtonColor = false,
            LayoutOrder = order,
        }, buttons)
        withCorner(button, 11)
        button.MouseButton1Click:Connect(function()
            if not state.done then
                callback()
            end
        end)
        return button
    end

    local function finish(allow, always)
        if state.done then
            return
        end
        state.done = true
        state.allow = allow
        state.always = always
        title.Text = allow and "Approved. Running the code now." or "Denied. Nothing was executed."
        title.TextColor3 = allow and Theme.ok or Theme.err
        for _, child in ipairs(buttons:GetChildren()) do
            if child:IsA("TextButton") then
                child.Active = false
                child.TextTransparency = 0.45
                child.BackgroundTransparency = 0.45
            end
        end
        self:SetStatus(allow and "Approved" or "Denied", allow and Theme.ok or Theme.err)
        self:ScrollToBottom()
    end

    decisionButton("Deny", Theme.surfaceHi, Theme.text, 0.24, 1, function()
        finish(false, false)
    end)
    decisionButton("Always allow", Theme.surfaceHi, Theme.text, 0.42, 2, function()
        finish(true, true)
    end)
    decisionButton("Run", Theme.accent, Theme.white, 0.32, 3, function()
        finish(true, false)
    end)

    self:SetStatus("Waiting for approval", Theme.warn)
    self:ScrollToBottom()

    while not state.done do
        if isCancelled and isCancelled() then
            finish(false, false)
        end
        task.wait(0.1)
    end

    self.pendingApproval = nil
    return state.allow, state.always
end

function UI:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    for _, connection in ipairs(self.connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    self.connections = {}
    if self.gui then
        pcall(function()
            self.gui:Destroy()
        end)
        self.gui = nil
    end
    self.root = nil
end

return UI

end
__modules["util"] = function()
local Util = {}

function Util.Trim(text)
    return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

function Util.Clamp(value, low, high)
    if value < low then
        return low
    end
    if value > high then
        return high
    end
    return value
end

function Util.Truncate(value, maxChars)
    local text = tostring(value)
    if #text <= maxChars then
        return text
    end
    return text:sub(1, maxChars) .. "\n... [truncated " .. tostring(#text - maxChars) .. " chars]"
end

function Util.FormatSeconds(seconds)
    if seconds < 1 then
        return string.format("%dms", math.floor(seconds * 1000 + 0.5))
    end
    return string.format("%.1fs", seconds)
end

function Util.Copy(source)
    local target = {}
    for key, value in pairs(source) do
        target[key] = value
    end
    return target
end

function Util.Count(source)
    local count = 0
    for _ in pairs(source) do
        count += 1
    end
    return count
end

function Util.Lines(text)
    local lines = {}
    local position = 1
    text = tostring(text or "")
    while position <= #text do
        local newline = text:find("\n", position, true)
        if newline then
            table.insert(lines, text:sub(position, newline - 1))
            position = newline + 1
        else
            table.insert(lines, text:sub(position))
            break
        end
    end
    if #lines == 0 then
        table.insert(lines, "")
    end
    return lines
end

function Util.SafeCall(fn, ...)
    if type(fn) ~= "function" then
        return false, "not a function"
    end
    local results = table.pack(pcall(fn, ...))
    if not results[1] then
        return false, results[2]
    end
    return true, table.unpack(results, 2, results.n)
end

function Util.RunWithTimeout(seconds, fn)
    local finished = false
    local succeeded = false
    local result = nil
    task.spawn(function()
        succeeded, result = pcall(fn)
        finished = true
    end)
    local deadline = os.clock() + seconds
    while not finished and os.clock() < deadline do
        task.wait(0.05)
    end
    if not finished then
        return false, "timed out after " .. tostring(seconds) .. "s"
    end
    if not succeeded then
        return false, tostring(result)
    end
    return true, result
end

function Util.ErrorText(err)
    if type(err) == "string" then
        return err
    end
    local ok, text = pcall(tostring, err)
    return ok and text or "unknown error"
end

return Util

end
return __require("main")
