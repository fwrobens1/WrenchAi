                ok = true,
                data = {
                    pattern = pattern,
                    matches = matches,
                    returned = #matches,
                    scriptsScanned = scanned,
                    totalScripts = #scripts,
                    decompileFailures = failures,
                    firstFailure = firstFailure,
                    truncated = #matches >= maxResults or scanned >= maxScripts,
                    timedOut = timedOut,
