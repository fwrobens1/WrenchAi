--!nocheck
-- WrenchAi bundle. Generated by build.mjs from src/. Do not edit by hand.
local __modules = {}
local __cache = {}
local function __require(id)
    local cached = __cache[id]
    if cached ~= nil then return cached end
    local loader = __modules[id]
    if not loader then error('module not found: ' .. tostring(id), 2) end
    local value = loader()
    __cache[id] = value
    return value
end
__modules["agent/loop"] = function()
local HttpService = game:GetService("HttpService")
local Client = __require("llm/client")
local Prompt = __require("agent/prompt")
local Serialize = __require("serialize")
local Util = __require("util")

local Loop = {}
Loop.__index = Loop

local MAX_CONTEXT_CHARS = 60000

local function messageChars(message)
    local size = #tostring(message.content or "")
    if type(message.tool_calls) == "table" then
        size += #message.tool_calls * 240
    end
    return size
end

local function isTurnStart(message)
    if message.role ~= "user" then
        return false
    end
    if type(message.content) == "string" and message.content:sub(1, 13) == "[TOOL RESULT:" then
        return false
    end
    return true
end

local function trimHistory(messages, budget)
    local total = 0
    for _, message in ipairs(messages) do
        total += messageChars(message)
    end
    if total <= budget then
        return messages
    end

    local keepFrom = 1
    while total > budget do
        local nextUser = nil
        for index = keepFrom + 1, #messages do
            if isTurnStart(messages[index]) then
                nextUser = index
                break
            end
        end
        if not nextUser then
            break
        end
        local laterUser = false
        for index = nextUser + 1, #messages do
            if isTurnStart(messages[index]) then
                laterUser = true
                break
            end
        end
        if not laterUser then
            break
        end
        for index = keepFrom, nextUser - 1 do
            total -= messageChars(messages[index])
        end
        keepFrom = nextUser
    end

    local trimmed = {}
    for index = keepFrom, #messages do
        table.insert(trimmed, messages[index])
    end
    return trimmed
end

local function normalizeContent(content)
    if content == nil then
        return nil
    end
    if type(content) == "string" then
        return content
    end
    if type(content) == "table" then
        if type(content.text) == "string" then
            return content.text
        end
        local parts = {}
        for _, part in ipairs(content) do
            if type(part) == "string" then
                table.insert(parts, part)
            elseif type(part) == "table" and type(part.text) == "string" then
                table.insert(parts, part.text)
            end
        end
        return table.concat(parts, "\n")
    end
    return tostring(content)
end

local function sanitizeToolCalls(rawCalls)
    local calls = {}
    if type(rawCalls) ~= "table" then
        return calls
    end
    for index, raw in ipairs(rawCalls) do
        local fn = raw["function"] or {}
        local name = fn.name
        if type(name) == "string" and name ~= "" then
            local arguments = fn.arguments
            if type(arguments) ~= "string" then
                local ok, encoded = pcall(function()
                    return HttpService:JSONEncode(arguments or {})
                end)
                arguments = ok and encoded or "{}"
            end
            table.insert(calls, {
                id = tostring(raw.id or ("call_" .. tostring(index))),
                type = "function",
                ["function"] = { name = name, arguments = arguments },
            })
        end
    end
    return calls
end

local function parseArguments(raw)
    if type(raw) == "table" then
        return raw
    end
    if raw == nil or raw == "" then
        return {}
    end
    if type(raw) ~= "string" then
        return nil, "Tool arguments were not a JSON string."
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if ok and type(decoded) == "table" then
        return decoded
    end
    return nil, "Tool arguments were not valid JSON: " .. Util.Truncate(raw, 200)
end

local function looksLikeToolRejection(err)
    local raw = string.lower(tostring(err.raw or err.message or ""))
    return raw:find("tool", 1, true) ~= nil
end

local function extractProtocolCall(content, tools)
    if type(content) ~= "string" then
        return nil
    end
    local text = Util.Trim(content)
    local fenced = text:match("```[%w]*%s*(.-)%s*```")
    if fenced then
        text = Util.Trim(fenced)
    end
    if text:sub(1, 1) ~= "{" or text:sub(-1) ~= "}" then
        return nil
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(text)
    end)
    if not ok or type(decoded) ~= "table" then
        return nil
    end
    local name = decoded.tool or decoded.name
    local args = decoded.args or decoded.arguments or {}
    if type(name) ~= "string" or not tools:Has(name) or type(args) ~= "table" then
        return nil
    end
    return { name = name, arguments = args }
end

function Loop.new(deps)
    local self = setmetatable({}, Loop)
    self.ui = deps.ui
    self.tools = deps.tools
    self.config = deps.config
    self.compat = deps.compat
    self.client = Client.new(deps.config)
    self.messages = {}
    self.running = false
    self.cancelled = false
    self.toolsSupported = true
    return self
end

function Loop:RefreshConfig(config)
    self.config = config
    self.client = Client.new(config)
end

function Loop:IsCancelled()
    return self.cancelled
end

function Loop:Cancel()
    self.cancelled = true
end

function Loop:Reset()
    self.messages = {}
    self.cancelled = false
end

function Loop:BuildSystem()
    local system = Prompt.Build(self.compat, self.config)
    local catalog = self.tools:PromptCatalog()
    if self.toolsSupported then
        return system
            .. "\n\n"
            .. catalog
            .. "\n\nUse the provided function tools. If they are unavailable, reply with ONLY a single JSON object:"
            .. ' {"tool":"tool_name","args":{...}}.'
    end
    return system
        .. "\n\n"
        .. catalog
        .. "\n\nThis endpoint has no native tool calling. To call a tool, reply with ONLY a single JSON object:"
        .. ' {"tool":"tool_name","args":{...}}.'
        .. " You will then receive a [TOOL RESULT] message. Otherwise answer the user normally."
end

function Loop:BuildRequest()
    local request = {
        { role = "system", content = self:BuildSystem() },
    }
    local history = trimHistory(self.messages, MAX_CONTEXT_CHARS)
    for _, message in ipairs(history) do
        table.insert(request, message)
    end
    return request
end

function Loop:RunTool(name, args, rawArguments)
    local card = self.ui:AddToolCard(name, Util.Truncate(rawArguments or "{}", 600))
    local started = os.clock()
    local result = self.tools:Call(name, args)
    local duration = os.clock() - started
    local json = Serialize.Encode(result, tonumber(self.config.maxToolChars) or 9000)
    card:Finish(result.ok ~= false, json, duration)
    return result, json
end

function Loop:Execute()
    local maxSteps = Util.Clamp(tonumber(self.config.maxSteps) or 12, 1, 30)
    local step = 1
    local finished = false

    while step <= maxSteps do
        if self.cancelled then
            break
        end
        self.ui:SetStatus("Thinking - step " .. tostring(step) .. "/" .. tostring(maxSteps))
        local schemas = self.toolsSupported and self.tools:Schemas() or nil
        local request = self:BuildRequest()
        local response, err = self.client:Chat(request, schemas, function()
            return self.cancelled
        end)

        if self.cancelled then
            break
        end

        if err then
            if self.toolsSupported and err.kind == "http" and looksLikeToolRejection(err) then
                self.toolsSupported = false
                self.ui:AddSystem("This endpoint rejected native tool calling; switched to the JSON tool protocol.")
                continue
            end
            self.ui:AddError(err.message or "The API request failed.")
            if err.kind == "auth" then
                self.ui:OpenSettings()
            end
            break
        end

        local choice = nil
        if type(response.data.choices) == "table" then
            choice = response.data.choices[1]
        end
        if not choice then
            self.ui:AddError("The API response contained no choices.")
            break
        end

        local message = choice.message or {}
        local content = normalizeContent(message.content)
        local calls = sanitizeToolCalls(message.tool_calls)

        if #calls > 0 then
            table.insert(self.messages, {
                role = "assistant",
                content = content or "",
                tool_calls = calls,
            })
            if content and Util.Trim(content) ~= "" then
                self.ui:AddMessage("assistant", content)
            end

            local limit = math.min(#calls, 6)
            for index = 1, limit do
                if self.cancelled then
                    break
                end
                local call = calls[index]
                local name = call["function"].name
                local args, argumentError = parseArguments(call["function"].arguments)
                local json
                if args then
                    local _, resultJson = self:RunTool(name, args, call["function"].arguments)
                    json = resultJson
                else
                    json = Serialize.Encode(
                        { ok = false, error = argumentError },
                        tonumber(self.config.maxToolChars) or 9000
                    )
                    self.ui:AddToolCard(name, "invalid arguments"):Finish(false, json, 0)
                end
                table.insert(self.messages, {
                    role = "tool",
                    tool_call_id = call.id,
                    content = json,
                })
            end
            for index = limit + 1, #calls do
                table.insert(self.messages, {
                    role = "tool",
                    tool_call_id = calls[index].id,
                    content = '{"ok":false,"error":"Skipped: per-step tool call limit reached."}',
                })
            end
            step += 1
        else
            local text = content or ""
            local protocolCall = extractProtocolCall(text, self.tools)
            if protocolCall then
                table.insert(self.messages, { role = "assistant", content = text })
                local argsJson = Serialize.Encode(protocolCall.arguments, 600)
                local _, resultJson = self:RunTool(protocolCall.name, protocolCall.arguments, argsJson)
                table.insert(self.messages, {
                    role = "user",
                    content = "[TOOL RESULT: "
                        .. protocolCall.name
                        .. "]\n"
                        .. resultJson
                        .. "\n\nContinue: call another tool or answer the user.",
                })
                step += 1
            else
                if Util.Trim(text) == "" then
                    text = "(The model returned no text.)"
                end
                self.ui:AddMessage("assistant", text)
                table.insert(self.messages, { role = "assistant", content = text })
                finished = true
                break
            end
        end
    end

    if self.cancelled then
        self.ui:AddSystem("Stopped.")
    elseif not finished then
        self.ui:AddSystem("Reached the step limit (" .. tostring(maxSteps) .. "). Send another message to continue.")
    end
end

function Loop:Send(text)
    if self.running then
        return
    end
    local clean = Util.Trim(text)
    if clean == "" then
        return
    end

    self.running = true
    self.cancelled = false
    table.insert(self.messages, { role = "user", content = clean })
    self.ui:SetRunning(true)
    self.ui:SetStatus("Thinking...")

    task.spawn(function()
        local ok, err = pcall(function()
            self:Execute()
        end)
        if not ok then
            self.ui:AddError("Agent error: " .. Util.ErrorText(err))
        end
        self.running = false
        self.ui:SetRunning(false)
        if self.cancelled then
            self.ui:SetStatus("Stopped")
        else
            self.ui:SetStatus("Ready")
        end
    end)
end

return Loop

end
__modules["agent/prompt"] = function()
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Prompt = {}

function Prompt.Build(compat, config)
    local localPlayer = Players.LocalPlayer
    local playerText = "unknown"
    if localPlayer then
        playerText = localPlayer.Name .. " (" .. tostring(localPlayer.UserId) .. ")"
    end
    local platform = UserInputService.TouchEnabled and "mobile" or "desktop"
    local lines = {
        "You are WrenchAi, an autonomous Roblox debugging agent running inside the user's executor on their own client.",
        "You can inspect the live game and execute Luau. Prefer evidence over guesses.",
        "",
        "Environment:",
        "- PlaceId: " .. tostring(game.PlaceId) .. " | GameId: " .. tostring(game.GameId),
        "- JobId: " .. tostring(game.JobId),
        "- Player: " .. playerText,
        "- Executor: " .. compat.ExecutorName .. " " .. compat.ExecutorVersion,
        "- Platform: " .. platform,
        "",
        "Rules:",
        "1. Inspect before changing anything. Never assume an instance path or script name.",
        "2. Use search_instances and get_descendants_tree with tight limits. Never dump the entire game.",
        "3. Use list_scripts to obtain debugIds, then read_script or grep_scripts for source.",
        "4. run_luau executes in the executor with full access. The user is asked to approve each script unless they enabled always-allow. Always return a compact, JSON-serializable value; print output is captured too.",
        "5. Remote spying is Cobalt only. Use the spy_* tools; do not install or hook a second remote spy.",
        "6. Only operate on places the user owns or is authorized to test. Do not use these tools against other players.",
        "7. Keep answers short and concrete. Use fenced code blocks when showing code. No markdown tables.",
        "8. If a tool fails, read the error and try a narrower call instead of repeating it unchanged.",
    }
    local extra = config.extraSystemPrompt
    if type(extra) == "string" and extra ~= "" then
        table.insert(lines, "")
        table.insert(lines, "Additional instructions from the user:")
        table.insert(lines, extra)
    end
    return table.concat(lines, "\n")
end

return Prompt

end
__modules["compat"] = function()
-- Executor capability detection.
-- The first-function-wins approach mirrors roblox-executor-mcp's MIT compat layer.
local Compat = {}

local function firstFunction(...)
    for index = 1, select("#", ...) do
        local value = select(index, ...)
        if type(value) == "function" then
            return value
        end
    end
    return nil
end

local function resolveEnvironment()
    local ok, environment = pcall(function()
        return getgenv()
    end)
    if ok and type(environment) == "table" then
        return environment, "getgenv"
    end
    if type(_G) == "table" then
        return _G, "_G"
    end
    local fenvOk, fenv = pcall(function()
        return getfenv(0)
    end)
    if fenvOk and type(fenv) == "table" then
        return fenv, "getfenv"
    end
    return {}, "none"
end

local Environment, EnvironmentSource = resolveEnvironment()
Compat.Environment = Environment
Compat.EnvironmentSource = EnvironmentSource
Compat.Features = {}

local function lookup(name)
    local ok, value = pcall(function()
        return Environment[name]
    end)
    if ok and value ~= nil then
        return value
    end
    if type(_G) == "table" and _G ~= Environment then
        local globalOk, globalValue = pcall(function()
            return _G[name]
        end)
        if globalOk then
            return globalValue
        end
    end
    return nil
end

local function nested(namespace, name)
    local owner = lookup(namespace)
    if type(owner) ~= "table" then
        return nil
    end
    local ok, value = pcall(function()
        return owner[name]
    end)
    if ok then
        return value
    end
    return nil
end

Compat.Lookup = lookup

local function detect(name)
    return type(lookup(name)) == "function"
end

local DETECTED_FUNCTIONS = {
    "loadstring", "decompile", "getscriptbytecode", "getscripthash", "getscriptclosure",
    "getconnections", "firesignal", "fireclickdetector", "firetouchinterest", "fireproximityprompt",
    "hookmetamethod", "hookfunction", "restorefunction", "getnamecallmethod", "newcclosure",
    "checkcaller", "clonefunction", "getrawmetatable", "setreadonly", "islclosure", "iscclosure",
    "getcallingscript", "getthreadidentity", "setthreadidentity", "setidentity", "cloneref",
    "getnilinstances", "getinstances", "getscripts", "getloadedmodules", "getcustomasset",
    "identifyexecutor", "getexecutorname", "writefile", "readfile", "isfile", "makefolder",
    "isfolder", "delfile", "listfiles", "gethui", "protectgui", "setclipboard", "getclipboard",
    "isrenderobj", "getrenderproperty", "setrenderproperty", "getproperties", "getattributes",
    "getfunctionhash", "queue_on_teleport", "keypress", "keyrelease", "mouse1click",
    "mouse1press", "mouse1release", "mousemoverel", "mousemoveabs", "getgenv",
}

for _, name in ipairs(DETECTED_FUNCTIONS) do
    Compat.Features[name] = detect(name)
end

local requestFunction = firstFunction(
    lookup("request"),
    lookup("http_request"),
    nested("syn", "request"),
    nested("http", "request"),
    nested("fluxus", "request")
)
Compat.Features.request = requestFunction ~= nil

local setIdentity = firstFunction(
    lookup("setthreadidentity"),
    lookup("setidentity"),
    nested("syn", "set_thread_identity")
)
Compat.Features.setthreadidentity = Compat.Features.setthreadidentity or setIdentity ~= nil

local identify = firstFunction(lookup("identifyexecutor"), lookup("getexecutorname"))
Compat.ExecutorName = "Unknown"
Compat.ExecutorVersion = ""
if identify then
    local ok, name, version = pcall(identify)
    if ok then
        Compat.ExecutorName = tostring(name or "Unknown")
        Compat.ExecutorVersion = tostring(version or "")
    end
end

function Compat.Has(name)
    return Compat.Features[name] == true
end

function Compat.Http(options)
    if not requestFunction then
        return nil, "This executor exposes no HTTP function (request, http_request, syn.request or http.request)."
    end
    local payload = {
        Url = options.Url,
        Method = options.Method or "GET",
        Headers = options.Headers or {},
        Body = options.Body or "",
    }
    local ok, response = pcall(requestFunction, payload)
    if not ok then
        return nil, "HTTP request failed: " .. tostring(response)
    end
    if type(response) ~= "table" then
        return nil, "Executor HTTP function returned no response table."
    end
    local status = tonumber(
        response.StatusCode or response.Status or response.status_code or response.status
    ) or 0
    return {
        status = status,
        body = response.Body or response.body or "",
        headers = response.Headers or response.headers or {},
    }
end

function Compat.HttpGet(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" and #body > 0 then
        return body
    end
    local response, errorMessage = Compat.Http({ Url = url, Method = "GET" })
    if not response then
        return nil, errorMessage
    end
    if response.status ~= 0 and response.status ~= 200 then
        return nil, "HTTP " .. tostring(response.status) .. " for " .. url
    end
    return response.body
end

function Compat.SetIdentity(identity)
    if not setIdentity then
        return false
    end
    local ok = pcall(setIdentity, identity or 8)
    return ok
end

function Compat.Decompile(script)
    local decompile = lookup("decompile")
    if type(decompile) == "function" then
        local ok, source = pcall(decompile, script)
        if ok and type(source) == "string" and #source > 0 then
            return source
        end
        return nil, tostring(source)
    end
    if Compat.Has("getscriptbytecode") then
        return nil, "This executor has getscriptbytecode but no decompile, so readable source is unavailable."
    end
    return nil, "This executor has no decompile function."
end

function Compat.Diagnostics()
    local available = {}
    for name, enabled in pairs(Compat.Features) do
        if enabled then
            table.insert(available, name)
        end
    end
    table.sort(available)
    return {
        executor = Compat.ExecutorName,
        version = Compat.ExecutorVersion,
        environment = EnvironmentSource,
        available = available,
    }
end

return Compat

end
__modules["config"] = function()
local HttpService = game:GetService("HttpService")
local Compat = __require("compat")
local Util = __require("util")

local Config = {}
local FOLDER = "WrenchAi"
local FILE = FOLDER .. "/config.json"

Config.Defaults = {
    baseURL = "https://api.refuseless.com/v1",
    model = "glm-5.3-abliterated",
    apiKey = "",
    temperature = 0.7,
    maxTokens = 2048,
    maxSteps = 12,
    maxToolChars = 9000,
    autoApproveScripts = false,
    cobaltURL = "https://raw.githubusercontent.com/Wortexios/CobaltSpy/refs/heads/main/Cobalt",
    dexURL = "https://github.com/Tesker-103/DexRecontinued/releases/latest/download/out.lua",
    extraSystemPrompt = "",
}

function Config.Path()
    return FILE
end

function Config.CanPersist()
    return Compat.Has("writefile")
end

local function merge(target, source)
    for key, value in pairs(source) do
        local default = target[key]
        if default ~= nil and type(default) == type(value) then
            target[key] = value
        end
    end
end

function Config.Load()
    local config = Util.Copy(Config.Defaults)

    local override = Compat.Environment.WrenchAiConfig
    if type(override) == "table" then
        merge(config, override)
    end

    local readfile = Compat.Lookup("readfile")
    local isfile = Compat.Lookup("isfile")
    if type(readfile) == "function" and type(isfile) == "function" then
        local existsOk, exists = pcall(isfile, FILE)
        if existsOk and exists then
            local readOk, raw = pcall(readfile, FILE)
            if readOk and type(raw) == "string" and #raw > 0 then
                local decodeOk, decoded = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)
                if decodeOk and type(decoded) == "table" then
                    merge(config, decoded)
                end
            end
        end
    end

    return config
end

function Config.Save(config)
    local writefile = Compat.Lookup("writefile")
    if type(writefile) ~= "function" then
        return false, "This executor has no writefile; settings stay for this session only."
    end
    local makefolder = Compat.Lookup("makefolder")
    if type(makefolder) == "function" then
        pcall(makefolder, FOLDER)
    end
    local encodeOk, encoded = pcall(function()
        return HttpService:JSONEncode(config)
    end)
    if not encodeOk then
        return false, "Could not encode settings."
    end
    local saved, errorMessage = pcall(writefile, FILE, encoded)
    if not saved then
        return false, tostring(errorMessage)
    end
    return true
end

return Config

end
__modules["llm/client"] = function()
local HttpService = game:GetService("HttpService")
local Compat = __require("compat")
local Util = __require("util")

local Client = {}
Client.__index = Client

local function trimBase(url)
    local text = Util.Trim(url)
    while #text > 0 and text:sub(-1) == "/" do
        text = text:sub(1, -2)
    end
    return text
end

local function parseErrorBody(raw)
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if ok and type(decoded) == "table" then
        local err = decoded.error
        if type(err) == "table" then
            return tostring(err.message or err.code or "API error")
        end
        if type(err) == "string" then
            return err
        end
        if decoded.message then
            return tostring(decoded.message)
        end
    end
    return Util.Truncate(raw or "", 400)
end

function Client.new(config)
    return setmetatable({ config = config }, Client)
end

function Client:Url()
    return trimBase(self.config.baseURL or "") .. "/chat/completions"
end

function Client:Chat(messages, tools, isCancelled)
    if type(self.config.apiKey) ~= "string" or Util.Trim(self.config.apiKey) == "" then
        return nil, {
            kind = "auth",
            message = "No API key configured. Open Settings (CFG) and paste your API key.",
            status = 0,
        }, 0
    end

    local body = {
        model = self.config.model,
        messages = messages,
        temperature = tonumber(self.config.temperature) or 0.7,
        max_tokens = tonumber(self.config.maxTokens) or 2048,
    }
    if tools and #tools > 0 then
        body.tools = tools
        body.tool_choice = "auto"
    end

    local encodeOk, encoded = pcall(function()
        return HttpService:JSONEncode(body)
    end)
    if not encodeOk then
        return nil, { kind = "encode", message = "Could not encode the request.", status = 0 }, 0
    end

    local headers = {
        ["Content-Type"] = "application/json",
        ["Accept"] = "application/json",
        ["Authorization"] = "Bearer " .. Util.Trim(self.config.apiKey),
    }

    local lastError = nil
    for attempt = 1, 3 do
        if isCancelled and isCancelled() then
            return nil, { kind = "cancelled", message = "Cancelled.", status = 0 }, 0
        end

        local started = os.clock()
        local response, requestError = Compat.Http({
            Url = self:Url(),
            Method = "POST",
            Headers = headers,
            Body = encoded,
        })

        if not response then
            lastError = { kind = "network", message = tostring(requestError), status = 0 }
        else
            local status = response.status
            local raw = response.body or ""
            if status == 200 or status == 0 then
                local decodeOk, decoded = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)
                if decodeOk and type(decoded) == "table" then
                    return {
                        data = decoded,
                        elapsed = os.clock() - started,
                        attempts = attempt,
                    }, nil, status
                end
                -- Some gateways stream SSE even when stream=false. Use the last data frame.
                local lastFrame = nil
                for line in raw:gmatch("[^\r\n]+") do
                    local payload = line:match("^data:%s*(.+)$")
                    if payload and payload ~= "[DONE]" then
                        lastFrame = payload
                    end
                end
                if lastFrame then
                    local frameOk, frame = pcall(function()
                        return HttpService:JSONDecode(lastFrame)
                    end)
                    if frameOk and type(frame) == "table" then
                        return {
                            data = frame,
                            elapsed = os.clock() - started,
                            attempts = attempt,
                        }, nil, status
                    end
                end
                lastError = {
                    kind = "decode",
                    message = "Endpoint returned non-JSON content: " .. Util.Truncate(raw, 300),
                    status = status,
                    raw = raw,
                }
            else
                local message = parseErrorBody(raw)
                lastError = {
                    kind = "http",
                    message = "HTTP " .. tostring(status) .. ": " .. message,
                    status = status,
                    raw = raw,
                }
                if status ~= 429 and status < 500 then
                    return nil, lastError, status
                end
            end
        end

        if attempt < 3 then
            task.wait(2 ^ (attempt - 1))
        end
    end

    return nil, lastError, lastError and lastError.status or 0
end

return Client

end
__modules["main"] = function()
local Compat = __require("compat")
local Config = __require("config")
local UI = __require("ui/window")
local Tools = __require("tools/init")
local Loop = __require("agent/loop")
local Util = __require("util")

local environment = Compat.Environment

local previous = environment.WrenchAi
if type(previous) == "table" then
    if previous.loop then
        pcall(function()
            previous.loop:Cancel()
        end)
    end
    if previous.ui and previous.ui.gui then
        pcall(function()
            previous.ui.gui:Destroy()
        end)
    end
end

local config = Config.Load()
local ui = UI.new({ config = config, compat = Compat, callbacks = {} })

local ctx = {
    config = config,
    compat = Compat,
    ui = ui,
    scriptCache = {},
    scriptIndex = nil,
    dexSource = nil,
}

local tools = Tools.new(ctx)
local loop = Loop.new({ ui = ui, tools = tools, config = config, compat = Compat })

ctx.isCancelled = function()
    return loop:IsCancelled()
end

ctx.approve = function(spec)
    return ui:AskApproval(spec, ctx.isCancelled)
end

ctx.setAutoApprove = function(value)
    local enabled = value == true
    ctx.config.autoApproveScripts = enabled
    if ui.pendingAutoApprove ~= enabled then
        ui.pendingAutoApprove = enabled
        ui:UpdateAutoApproveLabel()
    end
    Config.Save(ctx.config)
end

ui.callbacks.onSend = function(text)
    if Util.Trim(ctx.config.apiKey or "") == "" then
        ui:AddError("No API key yet. Open Settings and paste the key for " .. tostring(ctx.config.baseURL) .. ".")
        ui:OpenSettings()
        return
    end
    loop:Send(text)
end

ui.callbacks.onStop = function()
    loop:Cancel()
end

ui.callbacks.onNewChat = function()
    loop:Reset()
    ui:ClearMessages()
    ui:SetStatus("Ready")
end

ui.callbacks.onSaveSettings = function(newConfig)
    for key, value in pairs(newConfig) do
        ctx.config[key] = value
    end
    loop:RefreshConfig(ctx.config)
    local saved, message = Config.Save(ctx.config)
    if saved then
        return true, "Saved."
    end
    return true, "Applied for this session. " .. tostring(message or "The executor could not write the settings file.")
end

ui:SetStatus("Ready")
ui:AddSystem(
    "WrenchAi is running in "
        .. tostring(Compat.ExecutorName)
        .. ". I can inspect the game, read scripts, drive the GUI, use Cobalt, and run Luau when you approve it."
)

if not Compat.Has("request") then
    ui:AddError("This executor exposes no HTTP function (request/http_request/syn.request), so the model cannot be reached.")
end

if Util.Trim(ctx.config.apiKey or "") == "" then
    ui:AddError("No API key configured. Settings is open; enter the key once and press Save settings.")
    ui:OpenSettings()
end

local api = {
    ui = ui,
    loop = loop,
    tools = tools,
    config = ctx.config,
    toggle = function()
        ui:Toggle()
    end,
}

environment.WrenchAi = api
if type(_G) == "table" and _G ~= environment then
    pcall(function()
        _G.WrenchAi = api
    end)
end

return api

end
__modules["serialize"] = function()
local HttpService = game:GetService("HttpService")
local Serialize = {}

local function safeText(value)
    local ok, text = pcall(tostring, value)
    return ok and text or "<unprintable>"
end

local function convert(value, depth, seen)
    if value == nil then
        return nil
    end
    local kind = typeof(value)
    if kind == "string" or kind == "boolean" then
        return value
    end
    if kind == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return tostring(value)
        end
        return value
    end
    if kind == "Instance" then
        local path, name, className
        pcall(function()
            path = value:GetFullName()
            name = value.Name
            className = value.ClassName
        end)
        return { __type = "Instance", path = path or name, name = name, class = className }
    end
    if kind == "Vector3" then
        return { __type = "Vector3", x = value.X, y = value.Y, z = value.Z }
    end
    if kind == "Vector2" then
        return { __type = "Vector2", x = value.X, y = value.Y }
    end
    if kind == "CFrame" then
        local position = value.Position
        return { __type = "CFrame", x = position.X, y = position.Y, z = position.Z }
    end
    if kind == "Color3" then
        return { __type = "Color3", r = value.R, g = value.G, b = value.B }
    end
    if kind == "BrickColor" then
        return { __type = "BrickColor", name = safeText(value.Name) }
    end
    if kind == "UDim2" then
        return {
            __type = "UDim2",
            x = { scale = value.X.Scale, offset = value.X.Offset },
            y = { scale = value.Y.Scale, offset = value.Y.Offset },
        }
    end
    if kind == "UDim" then
        return { __type = "UDim", scale = value.Scale, offset = value.Offset }
    end
    if kind == "EnumItem" then
        return { __type = "EnumItem", value = safeText(value) }
    end
    if kind == "NumberRange" then
        return { __type = "NumberRange", min = value.Min, max = value.Max }
    end
    if kind == "NumberSequence" or kind == "ColorSequence" or kind == "Rect" then
        return safeText(value)
    end
    if kind == "function" then
        return "<function>"
    end
    if kind == "table" then
        if depth <= 0 then
            return "<table>"
        end
        if seen[value] then
            return "<cycle>"
        end
        seen[value] = true
        local result = {}
        local count = 0
        local ok = pcall(function()
            for key, child in pairs(value) do
                count += 1
                if count > 200 then
                    result.__truncated = true
                    break
                end
                result[tostring(key)] = convert(child, depth - 1, seen)
            end
        end)
        seen[value] = nil
        if not ok then
            return safeText(value)
        end
        return result
    end
    return safeText(value)
end

function Serialize.Value(value, depth)
    local ok, result = pcall(convert, value, depth or 4, {})
    if ok then
        return result
    end
    return safeText(value)
end

function Serialize.Encode(value, maxChars)
    local converted = Serialize.Value(value)
    local ok, json = pcall(function()
        return HttpService:JSONEncode(converted)
    end)
    if not ok then
        json = safeText(converted)
    end
    if maxChars and #json > maxChars then
        local wrapOk, wrapped = pcall(function()
            return HttpService:JSONEncode({
                truncated = true,
                chars = #json,
                preview = json:sub(1, maxChars),
            })
        end)
        if wrapOk then
            return wrapped
        end
        return '{"truncated":true}'
    end
    return json
end

return Serialize

end
__modules["tools/dex"] = function()
return {
    {
        name = "open_dex",
        description = "Launch the Dex Recontinued explorer UI. Useful for manual inspection; the agent's own tools stay available.",
        parameters = {
            type = "object",
            properties = {},
        },
        run = function(args, ctx)
            local source = ctx.dexSource
            if not source then
                local downloaded, downloadError = ctx.compat.HttpGet(ctx.config.dexURL)
                if not downloaded then
                    return { ok = false, error = "Could not download Dex: " .. tostring(downloadError) }
                end
                source = downloaded
                ctx.dexSource = source
            end

            local loadstringFunction = ctx.compat.Lookup("loadstring")
            if type(loadstringFunction) ~= "function" then
                return { ok = false, error = "This executor has no loadstring." }
            end
            local chunk, compileError = loadstringFunction(source)
            if not chunk then
                return { ok = false, error = "Dex failed to compile: " .. tostring(compileError) }
            end
            local ok, runError = pcall(chunk)
            if not ok then
                return { ok = false, error = "Dex failed to launch: " .. tostring(runError) }
            end
            return {
                ok = true,
                data = { message = "Dex launched. It has its own draggable window." },
            }
        end,
    },
}

end
__modules["tools/gui"] = function()
local GuiService = game:GetService("GuiService")
local Shared = __require("tools/shared")
local Util = __require("util")

local SIGNALS = {
    "Activated",
    "MouseButton1Down",
    "MouseButton2Down",
    "MouseButton1Click",
    "MouseButton2Click",
}

local function getVirtualInputManager()
    local ok, service = pcall(function()
        return game:GetService("VirtualInputManager")
    end)
    if ok and service then
        return service
    end
    local createOk, created = pcall(function()
        return Instance.new("VirtualInputManager")
    end)
    if createOk then
        return created
    end
    return nil
end

local function resolveGui(path)
    local instance, errorMessage = Shared.ResolvePath(path or "")
    if not instance then
        return nil, errorMessage
    end
    return instance
end

return {
    {
        name = "click_button",
        description = "Fire click signals on a GuiButton using firesignal, or a virtual mouse click when firesignal is unavailable.",
        parameters = {
            type = "object",
            properties = {
                path = Shared.StringProperty("Full path of the GuiButton.", nil),
                action = Shared.StringProperty("Optional signal: Activated, MouseButton1Click, MouseButton2Click, or a down signal.", nil),
            },
            required = { "path" },
        },
        run = function(args, ctx)
            local button, pathError = resolveGui(args.path)
            if not button then
                return { ok = false, error = pathError }
            end
            local classOk, isButton = pcall(function()
                return button:IsA("GuiButton")
            end)
            if not classOk or not isButton then
                return { ok = false, error = "That instance is a " .. button.ClassName .. ", not a GuiButton." }
            end
            local action = args.action
            if action and not table.find(SIGNALS, action) then
                return { ok = false, error = "action must be one of: " .. table.concat(SIGNALS, ", ") }
            end

            local firesignal = ctx.compat.Lookup("firesignal")
            if type(firesignal) == "function" then
                if action then
                    local ok, errorMessage = pcall(firesignal, button[action])
                    if not ok then
                        return { ok = false, error = "firesignal failed: " .. tostring(errorMessage) }
                    end
                else
                    local fired = 0
                    for _, name in ipairs(SIGNALS) do
                        local ok = pcall(firesignal, button[name])
                        if ok then
                            fired += 1
                        end
                    end
                    if fired == 0 then
                        return { ok = false, error = "firesignal failed for every button signal." }
                    end
                end
                return {
                    ok = true,
                    data = { path = button:GetFullName(), method = "firesignal", action = action or "all signals" },
                }
            end

            local virtualInput = getVirtualInputManager()
            if not virtualInput then
                return {
                    ok = false,
                    error = "This executor has neither firesignal nor a usable VirtualInputManager.",
                }
            end
            if not button.Visible or button.AbsoluteSize.X <= 0 or button.AbsoluteSize.Y <= 0 then
                return { ok = false, error = "Virtual mouse clicking needs a visible button with a nonzero size." }
            end
            if action and action ~= "Activated" and action ~= "MouseButton1Click" and action ~= "MouseButton2Click" then
                return { ok = false, error = "Down-only signals require firesignal." }
            end

            local center = button.AbsolutePosition + button.AbsoluteSize / 2
            local inset = GuiService:GetGuiInset()
            local x, y = center.X + inset.X, center.Y + inset.Y
            local mouseButton = action == "MouseButton2Click" and 1 or 0
            virtualInput:SendMouseMoveEvent(x, y, game)
            task.wait()
            virtualInput:SendMouseButtonEvent(x, y, mouseButton, true, game, 0)
            task.wait(0.05)
            virtualInput:SendMouseButtonEvent(x, y, mouseButton, false, game, 0)
            return {
                ok = true,
                data = {
                    path = button:GetFullName(),
                    method = "virtual-input",
                    note = "The button must be visible and unobstructed.",
                },
            }
        end,
    },
    {
        name = "type_text",
        description = "Set text on a TextBox and optionally focus/leave it. useKeyPress simulates typing when the executor supports it.",
        parameters = {
            type = "object",
            properties = {
                path = Shared.StringProperty("Full path of the TextBox.", nil),
                text = Shared.StringProperty("Text to enter.", nil),
                enter = Shared.BoolProperty("Release focus as if Enter was pressed.", false),
                useKeyPress = Shared.BoolProperty("Simulate per-character input instead of setting Text.", false),
            },
            required = { "path", "text" },
        },
        run = function(args, ctx)
            local textBox, pathError = resolveGui(args.path)
            if not textBox then
                return { ok = false, error = pathError }
            end
            local classOk, isTextBox = pcall(function()
                return textBox:IsA("TextBox")
            end)
            if not classOk or not isTextBox then
                return { ok = false, error = "That instance is a " .. textBox.ClassName .. ", not a TextBox." }
            end
            local text = tostring(args.text or "")
            textBox:CaptureFocus()
            task.wait(0.05)

            if args.useKeyPress then
                local virtualInput = getVirtualInputManager()
                local keypress = ctx.compat.Lookup("keypress")
                if virtualInput then
                    for index = 1, #text do
                        virtualInput:SendTextInput(text:sub(index, index), nil, game)
                        task.wait(0.01)
                    end
                elseif type(keypress) == "function" then
                    local keyrelease = ctx.compat.Lookup("keyrelease")
                    for index = 1, #text do
                        local byte = text:sub(index, index):upper():byte()
                        if byte then
                            keypress(byte)
                            task.wait(0.01)
                            if type(keyrelease) == "function" then
                                keyrelease(byte)
                            end
                        end
                    end
                else
                    textBox:ReleaseFocus(false)
                    return {
                        ok = false,
                        error = "This executor cannot simulate key input; call again with useKeyPress=false.",
                    }
                end
            else
                textBox.Text = text
            end

            textBox:ReleaseFocus(args.enter == true)
            return {
                ok = true,
                data = { path = textBox:GetFullName(), length = #text, method = args.useKeyPress and "keypress" or "direct" },
            }
        end,
    },
}

end
__modules["tools/init"] = function()
local SpyManager = __require("tools/spymanager")
local Util = __require("util")

local Tools = {}
Tools.__index = Tools

function Tools.new(ctx)
    local self = setmetatable({ ctx = ctx, entries = {}, order = {} }, Tools)
    self.ctx.spy = SpyManager.new(self.ctx)

    local modules = {
        __require("tools/inspect"),
        __require("tools/scripts"),
        __require("tools/run"),
        __require("tools/gui"),
        __require("tools/spy"),
        __require("tools/dex"),
    }
    for _, definitions in ipairs(modules) do
        for _, entry in ipairs(definitions) do
            self:Register(entry)
        end
    end
    return self
end

function Tools:Register(entry)
    assert(type(entry.name) == "string" and entry.name ~= "", "tool name is required")
    assert(type(entry.run) == "function", "tool " .. entry.name .. " needs a run function")
    self.entries[entry.name] = entry
    table.insert(self.order, entry.name)
end

function Tools:Has(name)
    return self.entries[name] ~= nil
end

function Tools:Schemas()
    local schemas = {}
    for _, name in ipairs(self.order) do
        local entry = self.entries[name]
        table.insert(schemas, {
            type = "function",
            ["function"] = {
                name = name,
                description = entry.description,
                parameters = entry.parameters
                    or { type = "object", properties = {} },
            },
        })
    end
    return schemas
end

function Tools:PromptCatalog()
    local lines = { "Available tools. Call one at a time with a single JSON object." }
    for _, name in ipairs(self.order) do
        local entry = self.entries[name]
        local arguments = {}
        if entry.parameters and entry.parameters.properties then
            for key in pairs(entry.parameters.properties) do
                table.insert(arguments, key)
            end
            table.sort(arguments)
        end
        table.insert(lines, "- " .. name .. "(" .. table.concat(arguments, ", ") .. "): " .. entry.description)
    end
    return table.concat(lines, "\n")
end

function Tools:Call(name, args)
    local entry = self.entries[name]
    if not entry then
        return { ok = false, error = "Unknown tool: " .. tostring(name) }
    end
    if type(args) ~= "table" then
        args = {}
    end
    local ok, result = pcall(entry.run, args, self.ctx)
    if not ok then
        return { ok = false, error = Util.ErrorText(result) }
    end
    if type(result) ~= "table" then
        return { ok = true, data = result }
    end
    if result.ok == nil then
        return { ok = true, data = result }
    end
    return result
end

return Tools

end
__modules["tools/inspect"] = function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local LogService = game:GetService("LogService")
local Serialize = __require("serialize")
local Shared = __require("tools/shared")
local Util = __require("util")

local function matchSelector(instance, selector)
    local lowered = string.lower(selector)
    if lowered:sub(1, 1) == "#" then
        return string.lower(instance.Name) == lowered:sub(2)
    end
    if lowered:sub(1, 1) == "." then
        return string.lower(instance.ClassName) == lowered:sub(2)
    end
    if string.lower(instance.ClassName) == lowered or string.lower(instance.Name) == lowered then
        return true
    end
    return string.find(string.lower(instance.Name), lowered, 1, true) ~= nil
end

local function searchFallback(root, selector, limit)
    local results = {}
    local visited = 0
    local queue = { root }
    local head = 1
    while head <= #queue and #results < limit and visited < 6000 do
        local current = queue[head]
        head += 1
        local ok, children = pcall(function()
            return current:GetChildren()
        end)
        if ok then
            for _, child in ipairs(children) do
                visited += 1
                if matchSelector(child, selector) then
                    table.insert(results, child)
                    if #results >= limit then
                        break
                    end
                end
                table.insert(queue, child)
                if visited >= 6000 then
                    break
                end
            end
        end
    end
    return results, visited
end

local PROPERTY_GROUPS = {
    "Name", "ClassName", "Parent", "Archivable", "Attributes", "Tags",
    "Visible", "Enabled", "Text", "TextColor3", "TextSize", "Font", "PlaceholderText",
    "BackgroundColor3", "BackgroundTransparency", "Image", "ImageColor3", "ImageTransparency",
    "Size", "Position", "AnchorPoint", "ZIndex", "LayoutOrder", "AbsoluteSize", "AbsolutePosition",
    "Rotation", "BorderSizePixel", "TextWrapped", "TextScaled", "RichText", "AutoButtonColor",
    "Position", "Orientation", "CFrame", "Anchored", "CanCollide", "CanTouch", "CanQuery",
    "Transparency", "Color", "Material", "Massless", "AssemblyLinearVelocity", "AssemblyAngularVelocity",
    "Value", "Health", "MaxHealth", "WalkSpeed", "JumpPower", "JumpHeight", "HipHeight",
    "Brightness", "Range", "Shadows", "Volume", "SoundId", "Playing", "Looped",
    "Disabled", "RunContext", "MaxPlayers", "DisplayName", "UserId", "Character",
}

local function getPropertyList(instance, requested)
    if type(requested) == "table" and #requested > 0 then
        return requested
    end
    local names = {}
    local seen = {}
    for _, name in ipairs(PROPERTY_GROUPS) do
        if not seen[name] then
            seen[name] = true
            table.insert(names, name)
        end
    end
    return names
end

local function readProperties(instance, requested)
    local properties = {}
    local names = getPropertyList(instance, requested)
    local truncated = false
    if #names > 60 then
        truncated = true
        names = { table.unpack(names, 1, 60) }
    end
    for _, name in ipairs(names) do
        if name ~= "Source" then
            local ok, value = pcall(function()
                return instance[name]
            end)
            if ok and value ~= nil then
                properties[name] = Serialize.Value(value, 3)
            end
        end
    end
    local attributes = nil
    pcall(function()
        attributes = instance:GetAttributes()
    end)
    local tags = nil
    pcall(function()
        tags = instance:GetTags()
    end)
    return properties, attributes, tags, truncated
end

return {
    {
        name = "get_game_info",
        description = "Return place, job, player, platform, executor name/version, and available executor capabilities.",
        parameters = {
            type = "object",
            properties = {
                includePlaceName = Shared.BoolProperty("Fetch the place name and creator from MarketplaceService.", false),
            },
        },
        run = function(args, ctx)
            local localPlayer = Players.LocalPlayer
            local player = nil
            if localPlayer then
                player = {
                    name = localPlayer.Name,
                    displayName = localPlayer.DisplayName,
                    userId = localPlayer.UserId,
                    character = localPlayer.Character and localPlayer.Character:GetFullName() or nil,
                }
            end
            local info = {
                placeId = game.PlaceId,
                gameId = game.GameId,
                jobId = game.JobId,
                placeVersion = game.PlaceVersion,
                player = player,
                platform = UserInputService.TouchEnabled and "mobile" or "desktop",
                studio = RunService:IsStudio(),
                maxPlayers = Players.MaxPlayers,
                executor = ctx.compat.Diagnostics(),
            }
            if args.includePlaceName then
                local ok, product = pcall(function()
                    return MarketplaceService:GetProductInfo(game.PlaceId)
                end)
                if ok and type(product) == "table" then
                    info.placeName = product.Name
                    info.creator = product.Creator and product.Creator.Name or nil
                    info.creatorType = product.Creator and tostring(product.Creator.CreatorType) or nil
                end
            end
            return { ok = true, data = info }
        end,
    },
    {
        name = "search_instances",
        description = "Find instances under a root using a Roblox selector (ClassName, #Name, .ClassName) or a name/class substring.",
        parameters = {
            type = "object",
            properties = {
                root = Shared.StringProperty("Root path, for example game.Workspace or Players.LocalPlayer.PlayerGui.", "game"),
                selector = Shared.StringProperty("Selector or name/class substring.", nil),
                limit = Shared.IntProperty("Maximum results.", 30, 1, 100),
            },
            required = { "selector" },
        },
        run = function(args, ctx)
            local selector = Util.Trim(args.selector or "")
            if selector == "" then
                return { ok = false, error = "selector is required." }
            end
            local root, rootError = Shared.ResolvePath(args.root or "game")
            if not root then
                return { ok = false, error = rootError }
            end
            local limit = Util.Clamp(tonumber(args.limit) or 30, 1, 100)
            local matches = nil
            local usedFallback = false
            if type(root.QueryDescendants) == "function" then
                local ok, result = pcall(function()
                    return root:QueryDescendants(selector)
                end)
                if ok and type(result) == "table" and #result > 0 then
                    matches = result
                end
            end
            if not matches then
                usedFallback = true
                matches = searchFallback(root, selector, limit)
            end

            local results = {}
            for index = 1, math.min(#matches, limit) do
                table.insert(results, Shared.Describe(matches[index]))
            end
            return {
                ok = true,
                data = {
                    root = root:GetFullName(),
                    selector = selector,
                    count = #matches,
                    returned = #results,
                    truncated = #matches > limit,
                    fallback = usedFallback,
                    results = results,
