    for index, prompt in ipairs(prompts) do
        local chip = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            Position = UDim2.new(0, 0, 0, 54 + (index - 1) * 38),
            BackgroundColor3 = Theme.surface,
