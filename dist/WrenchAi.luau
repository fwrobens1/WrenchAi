--!nocheck
-- WrenchAi bundle. Generated by build.mjs from src/. Do not edit by hand.
local __modules = {}
local __cache = {}
local function __require(id)
    local cached = __cache[id]
    if cached ~= nil then return cached end
    local loader = __modules[id]
    if not loader then error('module not found: ' .. tostring(id), 2) end
    local value = loader()
    __cache[id] = value
    return value
end
__modules["agent/chats"] = function()
local HttpService = game:GetService("HttpService")
local Compat = __require("compat")
local Util = __require("util")

local Chats = {}
local FOLDER = "WrenchAi"
local FILE = FOLDER .. "/history.json"

Chats.MaxChats = 30
Chats.MaxMessages = 160
Chats.MaxChars = 60000

function Chats.NewId()
    return tostring(os.time()) .. "-" .. tostring(math.random(1000, 9999))
end

function Chats.TitleOf(text)
    local title = Util.Truncate(Util.Trim(text or ""), 34)
    if title == "" then
        return "New chat"
    end
    return title
end

function Chats.PreviewOf(messages)
    for index = #messages, 1, -1 do
        local message = messages[index]
        if message.role == "assistant" then
            local text = Util.Trim(tostring(message.content or ""))
            if text ~= "" and not Chats.IsProtocolJson(text) then
                return Util.Truncate(text, 72)
            end
        end
    end
    return ""
end

function Chats.IsProtocolJson(text)
    local value = Util.Trim(tostring(text or ""))
    local fenced = value:match("^```[%w]*%s*(.-)%s*```$")
    if fenced then
        value = Util.Trim(fenced)
    end
    if value:sub(1, 1) ~= "{" or value:sub(-1) ~= "}" then
        return false
    end
    return value:find('"tool"', 1, true) ~= nil
end

local function isTurnStart(message)
    if message.role ~= "user" then
        return false
    end
    return tostring(message.content or ""):sub(1, 13) ~= "[TOOL RESULT:"
end

local function messageChars(message)
    return #tostring(message.content or "") + #tostring(message.reasoning_content or "")
end

function Chats.Trim(messages)
    local kept = {}
    for index = math.max(1, #messages - Chats.MaxMessages + 1), #messages do
        table.insert(kept, messages[index])
    end

    local total = 0
    for _, message in ipairs(kept) do
        total += messageChars(message)
    end
    while total > Chats.MaxChars and #kept > 1 do
        local cut = nil
        for index = 2, #kept do
            if isTurnStart(kept[index]) then
                cut = index
                break
            end
        end
        if not cut then
            break
        end
        for index = 1, cut - 1 do
            total -= messageChars(kept[index])
        end
        local rest = {}
        for index = cut, #kept do
            table.insert(rest, kept[index])
        end
        kept = rest
    end
    return kept
end

function Chats.Load()
    local chats = {}
    local readfile = Compat.Lookup("readfile")
    local isfile = Compat.Lookup("isfile")
    if type(readfile) == "function" and type(isfile) == "function" then
        local existsOk, exists = pcall(isfile, FILE)
        if existsOk and exists then
            local readOk, raw = pcall(readfile, FILE)
            if readOk and type(raw) == "string" and #raw > 0 then
                local ok, decoded = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)
                if ok and type(decoded) == "table" then
                    for _, chat in ipairs(decoded) do
                        if type(chat) == "table" and type(chat.id) == "string"
                            and type(chat.messages) == "table" then
                            table.insert(chats, {
                                id = chat.id,
                                title = type(chat.title) == "string" and chat.title or "New chat",
                                createdAt = tonumber(chat.createdAt) or os.time(),
                                messages = chat.messages,
                            })
                        end
                    end
                end
            end
        end
    end
    return chats
end

function Chats.Save(chats)
    local writefile = Compat.Lookup("writefile")
    if type(writefile) ~= "function" then
        return false
    end
    local makefolder = Compat.Lookup("makefolder")
    if type(makefolder) == "function" then
        pcall(makefolder, FOLDER)
    end
    local trimmed = {}
    for index = 1, math.min(#chats, Chats.MaxChats) do
        local chat = chats[index]
        table.insert(trimmed, {
            id = chat.id,
            title = chat.title,
            createdAt = chat.createdAt,
            messages = Chats.Trim(chat.messages or {}),
        })
    end
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(trimmed)
    end)
    if not ok then
        return false
    end
    pcall(writefile, FILE, encoded)
    return true
end

return Chats

end
__modules["agent/loop"] = function()
local HttpService = game:GetService("HttpService")
local Client = __require("llm/client")
local Prompt = __require("agent/prompt")
local Serialize = __require("serialize")
local Util = __require("util")

local Loop = {}
Loop.__index = Loop

local MAX_CONTEXT_CHARS = 60000

local function messageChars(message)
    local size = #tostring(message.content or "")
    size += #tostring(message.reasoning_content or "")
    if type(message.tool_calls) == "table" then
        size += #message.tool_calls * 240
    end
    return size
end

local function isTurnStart(message)
    if message.role ~= "user" then
        return false
    end
    if type(message.content) == "string" and message.content:sub(1, 13) == "[TOOL RESULT:" then
        return false
    end
    return true
end

local function trimHistory(messages, budget)
    local total = 0
    for _, message in ipairs(messages) do
        total += messageChars(message)
    end
    if total <= budget then
        return messages
    end

    local keepFrom = 1
    while total > budget do
        local nextUser = nil
        for index = keepFrom + 1, #messages do
            if isTurnStart(messages[index]) then
                nextUser = index
                break
            end
        end
        if not nextUser then
            break
        end
        local laterUser = false
        for index = nextUser + 1, #messages do
            if isTurnStart(messages[index]) then
                laterUser = true
                break
            end
        end
        if not laterUser then
            break
        end
        for index = keepFrom, nextUser - 1 do
            total -= messageChars(messages[index])
        end
        keepFrom = nextUser
    end

    local trimmed = {}
    for index = keepFrom, #messages do
        table.insert(trimmed, messages[index])
    end
    return trimmed
end

local function normalizeContent(content)
    if content == nil then
        return nil
    end
    if type(content) == "string" then
        return content
    end
    if type(content) == "table" then
        if type(content.text) == "string" then
            return content.text
        end
        local parts = {}
        for _, part in ipairs(content) do
            if type(part) == "string" then
                table.insert(parts, part)
            elseif type(part) == "table" and type(part.text) == "string" then
                table.insert(parts, part.text)
            end
        end
        return table.concat(parts, "\n")
    end
    return tostring(content)
end

-- Reflection's API sometimes leaks its parameter-injection tags into
-- content and reasoning_content; they break JSON tool-call detection.
local function stripRflTags(text)
    if type(text) ~= "string" then
        return text
    end
    return (text:gsub("</?rfl:[^>]*>", ""))
end

local function sanitizeToolCalls(rawCalls)
    local calls = {}
    if type(rawCalls) ~= "table" then
        return calls
    end
    for index, raw in ipairs(rawCalls) do
        local fn = raw["function"] or {}
        local name = fn.name
        if type(name) == "string" and name ~= "" then
            local arguments = fn.arguments
            if type(arguments) ~= "string" then
                local ok, encoded = pcall(function()
                    return HttpService:JSONEncode(arguments or {})
                end)
                arguments = ok and encoded or "{}"
            end
            table.insert(calls, {
                id = tostring(raw.id or ("call_" .. tostring(index))),
                type = "function",
                ["function"] = { name = name, arguments = arguments },
            })
        end
    end
    return calls
end

local function parseArguments(raw)
    if type(raw) == "table" then
        return raw
    end
    if raw == nil or raw == "" then
        return {}
    end
    if type(raw) ~= "string" then
        return nil, "Tool arguments were not a JSON string."
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if ok and type(decoded) == "table" then
        return decoded
    end
    return nil, "Tool arguments were not valid JSON: " .. Util.Truncate(raw, 200)
end

local function looksLikeToolRejection(err)
    local raw = string.lower(tostring(err.raw or err.message or ""))
    return raw:find("tool", 1, true) ~= nil
end

local function looksLikeReasoningError(err)
    local raw = string.lower(tostring(err.raw or err.message or ""))
    return raw:find("reasoning", 1, true) ~= nil
end

local function keepLastUserTurn(messages)
    for index = #messages, 1, -1 do
        if isTurnStart(messages[index]) then
            return { messages[index] }
        end
    end
    return {}
end

local function extractProtocolCall(content, tools)
    if type(content) ~= "string" then
        return nil
    end
    local text = Util.Trim(content)
    local fenced = text:match("```[%w]*%s*(.-)%s*```")
    if fenced then
        text = Util.Trim(fenced)
    end
    if text:sub(1, 1) ~= "{" or text:sub(-1) ~= "}" then
        return nil
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(text)
    end)
    if not ok or type(decoded) ~= "table" then
        return nil
    end
    local name = decoded.tool or decoded.name
    local args = decoded.args or decoded.arguments or {}
    if type(name) ~= "string" or not tools:Has(name) or type(args) ~= "table" then
        return nil
    end
    return { name = name, arguments = args }
end

function Loop.new(deps)
    local self = setmetatable({}, Loop)
    self.ui = deps.ui
    self.tools = deps.tools
    self.config = deps.config
    self.compat = deps.compat
    self.client = Client.new(deps.config)
    self.messages = {}
    self.running = false
    self.cancelled = false
    self.toolsSupported = true
    self.recoveredHistory = false
    self.onDone = deps.onDone
    return self
end

function Loop:GetMessages()
    return self.messages
end

function Loop:SetMessages(messages)
    self.messages = Util.Copy(messages or {})
    self.continueCount = 0
    self.recoveredHistory = false
end

function Loop:RefreshConfig(config)
    self.config = config
    self.client = Client.new(config)
end

function Loop:IsCancelled()
    return self.cancelled
end

function Loop:Cancel()
    self.cancelled = true
end

function Loop:Reset()
    self.messages = {}
    self.cancelled = false
    self.continueCount = 0
    self.recoveredHistory = false
end

function Loop:BuildSystem()
    local system = Prompt.Build(self.compat, self.config)
    local catalog = self.tools:PromptCatalog()
    if self.toolsSupported then
        return system
            .. "\n\n"
            .. catalog
            .. "\n\nUse the provided function tools. If they are unavailable, reply with ONLY a single JSON object:"
            .. ' {"tool":"tool_name","args":{...}}.'
    end
    return system
        .. "\n\n"
        .. catalog
        .. "\n\nThis endpoint has no native tool calling. To call a tool, reply with ONLY a single JSON object:"
        .. ' {"tool":"tool_name","args":{...}}.'
        .. " You will then receive a [TOOL RESULT] message. Otherwise answer the user normally."
end

function Loop:BuildRequest()
    local request = {
        { role = "system", content = self:BuildSystem() },
    }
    local history = trimHistory(self.messages, MAX_CONTEXT_CHARS)
    for _, message in ipairs(history) do
        table.insert(request, message)
    end
    return request
end

function Loop:RunTool(name, args, rawArguments)
    local card = self.ui:AddToolCard(name, Util.Truncate(rawArguments or "{}", 600))
    local started = os.clock()
    local result = self.tools:Call(name, args)
    local duration = os.clock() - started
    local json = Serialize.Encode(result, tonumber(self.config.maxToolChars) or 9000)
    card:Finish(result.ok ~= false, json, duration)
    return result, json
end

function Loop:Execute()
    local maxSteps = Util.Clamp(tonumber(self.config.maxSteps) or 12, 1, 30)
    local step = 1
    local finished = false

    while step <= maxSteps do
        if self.cancelled then
            break
        end
        self.ui:SetStatus("Thinking - step " .. tostring(step) .. "/" .. tostring(maxSteps))
        local schemas = self.toolsSupported and self.tools:Schemas() or nil
        local request = self:BuildRequest()
        local response, err = self.client:Chat(request, schemas, function()
            return self.cancelled
        end)

        if self.cancelled then
            break
        end

        if err then
            if self.toolsSupported and err.kind == "http" and looksLikeToolRejection(err) then
                self.toolsSupported = false
                self.ui:AddSystem("This endpoint rejected native tool calling; switched to the JSON tool protocol.")
                continue
            end
            -- Beam requires reasoning_content to be echoed on every earlier
            -- assistant message. If history from an older session lacks it,
            -- restart this turn with a fresh context instead of failing.
            if err.kind == "http" and looksLikeReasoningError(err) and not self.recoveredHistory then
                self.recoveredHistory = true
                self.messages = keepLastUserTurn(self.messages)
                self.ui:AddSystem("The model needed reasoning history that isn't available; restarted this turn with a fresh context.")
                continue
            end
            self.ui:AddError(err.message or "The API request failed.")
            if err.kind == "auth" then
                self.ui:OpenSettings()
            end
            break
        end

        local choice = nil
        if type(response.data.choices) == "table" then
            choice = response.data.choices[1]
        end
        if not choice then
            self.ui:AddError("The API response contained no choices.")
            break
        end

        local message = choice.message or {}
        local content = stripRflTags(normalizeContent(message.content))
        local reasoning = stripRflTags(normalizeContent(message.reasoning_content))
        local calls = sanitizeToolCalls(message.tool_calls)
        -- Beam demands the reasoning of every earlier assistant message be
        -- sent back with it; cap it so history does not blow the budget.
        local storedReasoning = Util.Truncate(reasoning or "", 4000)

        -- Reasoning models think in a separate field; surface it as a
        -- collapsible trace so long invisible pauses become visible progress.
        if Util.Trim(reasoning or "") ~= "" then
            self.ui:AddThinking(reasoning)
        end

        if #calls > 0 then
            table.insert(self.messages, {
                role = "assistant",
                content = content or "",
                reasoning_content = storedReasoning,
                tool_calls = calls,
            })
            if content and Util.Trim(content) ~= "" then
                self.ui:AddMessage("assistant", content)
            end

            local limit = math.min(#calls, 6)
            for index = 1, limit do
                if self.cancelled then
                    break
                end
                local call = calls[index]
                local name = call["function"].name
                local args, argumentError = parseArguments(call["function"].arguments)
                local json
                if args then
                    local _, resultJson = self:RunTool(name, args, call["function"].arguments)
                    json = resultJson
                else
                    json = Serialize.Encode(
                        { ok = false, error = argumentError },
                        tonumber(self.config.maxToolChars) or 9000
                    )
                    self.ui:AddToolCard(name, "invalid arguments"):Finish(false, json, 0)
                end
                table.insert(self.messages, {
                    role = "tool",
                    tool_call_id = call.id,
                    content = json,
                })
            end
            for index = limit + 1, #calls do
                table.insert(self.messages, {
                    role = "tool",
                    tool_call_id = calls[index].id,
                    content = '{"ok":false,"error":"Skipped: per-step tool call limit reached."}',
                })
            end
            step += 1
        else
            local text = content or ""
            local protocolCall = extractProtocolCall(text, self.tools)
            if protocolCall then
                table.insert(self.messages, {
                    role = "assistant",
                    content = text,
                    reasoning_content = storedReasoning,
                })
                local argsJson = Serialize.Encode(protocolCall.arguments, 600)
                local _, resultJson = self:RunTool(protocolCall.name, protocolCall.arguments, argsJson)
                table.insert(self.messages, {
                    role = "user",
                    content = "[TOOL RESULT: "
                        .. protocolCall.name
                        .. "]\n"
                        .. resultJson
                        .. "\n\nContinue: call another tool or answer the user.",
                })
                step += 1
            elseif Util.Trim(text) == "" and Util.Trim(reasoning or "") ~= "" then
                -- Beam sometimes stops right after its internal reasoning
                -- without emitting content. Ask it to finish the thought.
                table.insert(self.messages, {
                    role = "assistant",
                    content = "",
                    reasoning_content = storedReasoning,
                })
                self.continueCount = (self.continueCount or 0) + 1
                if self.continueCount > 3 then
                    self.ui:AddError("The model kept thinking without answering. Try sending the message again.")
                    finished = true
                    break
                end
                local nudge = "Continue now. Output ONLY your next step, with no explanations:"
                if self.toolsSupported then
                    nudge = nudge .. " call one of the provided tools, or give your final answer as plain text."
                else
                    nudge = nudge .. ' plain text, or exactly one JSON object {"tool":"name","args":{...}}.'
                end
                table.insert(self.messages, { role = "user", content = nudge })
                step += 1
            else
                if Util.Trim(text) == "" then
                    text = "(The model returned no text.)"
                end
                self.ui:AddMessage("assistant", text)
                table.insert(self.messages, {
                    role = "assistant",
                    content = text,
                    reasoning_content = storedReasoning,
                })
                finished = true
                break
            end
        end
    end

    if self.cancelled then
        self.ui:AddSystem("Stopped.")
    elseif not finished then
        self.ui:AddSystem("Reached the step limit (" .. tostring(maxSteps) .. "). Send another message to continue.")
    end
end

function Loop:Send(text)
    if self.running then
        return
    end
    local clean = Util.Trim(text)
    if clean == "" then
        return
    end

    self.running = true
    self.cancelled = false
    self.continueCount = 0
    self.recoveredHistory = false
    table.insert(self.messages, { role = "user", content = clean })
    self.ui:SetRunning(true)
    self.ui:SetStatus("Thinking...")

    task.spawn(function()
        local ok, err = pcall(function()
            self:Execute()
        end)
        if not ok then
            self.ui:AddError("Agent error: " .. Util.ErrorText(err))
        end
        self.running = false
        self.ui:SetRunning(false)
        if self.cancelled then
            self.ui:SetStatus("Stopped")
        else
            self.ui:SetStatus("Ready")
        end
        if self.onDone then
            pcall(self.onDone)
        end
    end)
end

return Loop

end
__modules["agent/prompt"] = function()
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Prompt = {}

function Prompt.Build(compat, config)
    local localPlayer = Players.LocalPlayer
    local playerText = "unknown"
    if localPlayer then
        playerText = localPlayer.Name .. " (" .. tostring(localPlayer.UserId) .. ")"
    end
    local platform = UserInputService.TouchEnabled and "mobile" or "desktop"
    local lines = {
        "You are WrenchAi, an autonomous Roblox debugging agent running inside the user's executor on their own client.",
        "You can inspect the live game and execute Luau. Prefer evidence over guesses.",
        "",
        "Environment:",
        "- PlaceId: " .. tostring(game.PlaceId) .. " | GameId: " .. tostring(game.GameId),
        "- JobId: " .. tostring(game.JobId),
        "- Player: " .. playerText,
        "- Executor: " .. compat.ExecutorName .. " " .. compat.ExecutorVersion,
        "- Platform: " .. platform,
        "",
        "Rules:",
        "1. Inspect before changing anything. Never assume an instance path or script name.",
        "2. Use search_instances and get_descendants_tree with tight limits. Never dump the entire game.",
        "3. Use list_scripts to obtain debugIds, then read_script or grep_scripts for source.",
        "4. run_luau executes in the executor with full access. The user is asked to approve each script unless they enabled always-allow. Always return a compact, JSON-serializable value; print output is captured too.",
        "5. Remote spying is Cobalt only. Use the spy_* tools; do not install or hook a second remote spy.",
        "6. Only operate on places the user owns or is authorized to test. Do not use these tools against other players.",
        "7. Keep answers short and concrete. Use fenced code blocks when showing code. No markdown tables.",
        "8. If a tool fails, read the error and try a narrower call instead of repeating it unchanged.",
    }
    local extra = config.extraSystemPrompt
    if type(extra) == "string" and extra ~= "" then
        table.insert(lines, "")
        table.insert(lines, "Additional instructions from the user:")
        table.insert(lines, extra)
    end
    return table.concat(lines, "\n")
end

return Prompt

end
__modules["compat"] = function()
-- Executor capability detection.
-- The first-function-wins approach mirrors roblox-executor-mcp's MIT compat layer.
local Compat = {}

local function firstFunction(...)
    for index = 1, select("#", ...) do
        local value = select(index, ...)
        if type(value) == "function" then
            return value
        end
    end
    return nil
end

local function resolveEnvironment()
    local ok, environment = pcall(function()
        return getgenv()
    end)
    if ok and type(environment) == "table" then
        return environment, "getgenv"
    end
    if type(_G) == "table" then
        return _G, "_G"
    end
    local fenvOk, fenv = pcall(function()
        return getfenv(0)
    end)
    if fenvOk and type(fenv) == "table" then
        return fenv, "getfenv"
    end
    return {}, "none"
end

local Environment, EnvironmentSource = resolveEnvironment()
Compat.Environment = Environment
Compat.EnvironmentSource = EnvironmentSource
Compat.Features = {}

local function lookup(name)
    local ok, value = pcall(function()
        return Environment[name]
    end)
    if ok and value ~= nil then
        return value
    end
    if type(_G) == "table" and _G ~= Environment then
        local globalOk, globalValue = pcall(function()
            return _G[name]
        end)
        if globalOk then
            return globalValue
        end
    end
    return nil
end

local function nested(namespace, name)
    local owner = lookup(namespace)
    if type(owner) ~= "table" then
        return nil
    end
    local ok, value = pcall(function()
        return owner[name]
    end)
    if ok then
        return value
    end
    return nil
end

Compat.Lookup = lookup

local function detect(name)
    return type(lookup(name)) == "function"
end

local DETECTED_FUNCTIONS = {
    "loadstring", "decompile", "getscriptbytecode", "getscripthash", "getscriptclosure",
    "getconnections", "firesignal", "fireclickdetector", "firetouchinterest", "fireproximityprompt",
    "hookmetamethod", "hookfunction", "restorefunction", "getnamecallmethod", "newcclosure",
    "checkcaller", "clonefunction", "getrawmetatable", "setreadonly", "islclosure", "iscclosure",
    "getcallingscript", "getthreadidentity", "setthreadidentity", "setidentity", "cloneref",
    "getnilinstances", "getinstances", "getscripts", "getloadedmodules", "getcustomasset",
    "identifyexecutor", "getexecutorname", "writefile", "readfile", "isfile", "makefolder",
    "isfolder", "delfile", "listfiles", "gethui", "protectgui", "setclipboard", "getclipboard",
    "isrenderobj", "getrenderproperty", "setrenderproperty", "getproperties", "getattributes",
    "getfunctionhash", "queue_on_teleport", "keypress", "keyrelease", "mouse1click",
    "mouse1press", "mouse1release", "mousemoverel", "mousemoveabs", "getgenv",
}

for _, name in ipairs(DETECTED_FUNCTIONS) do
    Compat.Features[name] = detect(name)
end

local requestFunction = firstFunction(
    lookup("request"),
    lookup("http_request"),
    nested("syn", "request"),
    nested("http", "request"),
    nested("fluxus", "request")
)
Compat.Features.request = requestFunction ~= nil

local setIdentity = firstFunction(
    lookup("setthreadidentity"),
    lookup("setidentity"),
    nested("syn", "set_thread_identity")
)
Compat.Features.setthreadidentity = Compat.Features.setthreadidentity or setIdentity ~= nil

local identify = firstFunction(lookup("identifyexecutor"), lookup("getexecutorname"))
Compat.ExecutorName = "Unknown"
Compat.ExecutorVersion = ""
if identify then
    local ok, name, version = pcall(identify)
    if ok then
        Compat.ExecutorName = tostring(name or "Unknown")
        Compat.ExecutorVersion = tostring(version or "")
    end
end

function Compat.Has(name)
    return Compat.Features[name] == true
end

function Compat.Http(options)
    if not requestFunction then
        return nil, "This executor exposes no HTTP function (request, http_request, syn.request or http.request)."
    end
    local payload = {
        Url = options.Url,
        Method = options.Method or "GET",
        Headers = options.Headers or {},
        Body = options.Body or "",
    }
    local ok, response = pcall(requestFunction, payload)
    if not ok then
        return nil, "HTTP request failed: " .. tostring(response)
    end
    if type(response) ~= "table" then
        return nil, "Executor HTTP function returned no response table."
    end
    local status = tonumber(
        response.StatusCode or response.Status or response.status_code or response.status
    ) or 0
    return {
        status = status,
        body = response.Body or response.body or "",
        headers = response.Headers or response.headers or {},
    }
end

function Compat.HttpGet(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" and #body > 0 then
        return body
    end
    local response, errorMessage = Compat.Http({ Url = url, Method = "GET" })
    if not response then
        return nil, errorMessage
    end
    if response.status ~= 0 and response.status ~= 200 then
        return nil, "HTTP " .. tostring(response.status) .. " for " .. url
    end
    return response.body
end

function Compat.SetIdentity(identity)
    if not setIdentity then
        return false
    end
    local ok = pcall(setIdentity, identity or 8)
    return ok
end

function Compat.Decompile(script)
    local decompile = lookup("decompile")
    if type(decompile) == "function" then
        local ok, source = pcall(decompile, script)
        if ok and type(source) == "string" and #source > 0 then
            return source
        end
        return nil, tostring(source)
    end
    if Compat.Has("getscriptbytecode") then
        return nil, "This executor has getscriptbytecode but no decompile, so readable source is unavailable."
    end
    return nil, "This executor has no decompile function."
end

function Compat.Diagnostics()
    local available = {}
    for name, enabled in pairs(Compat.Features) do
        if enabled then
            table.insert(available, name)
        end
    end
    table.sort(available)
    return {
        executor = Compat.ExecutorName,
        version = Compat.ExecutorVersion,
        environment = EnvironmentSource,
        available = available,
    }
end

