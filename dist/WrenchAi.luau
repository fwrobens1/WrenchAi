                                table.insert(matches, {
                                    path = path,
                                    debugId = debugId,
                                    line = lineNumber,
                                    text = Util.Truncate(Util.Trim(line), 240),
                                })
                                if #matches >= maxResults then
                                    break
                                end
                            end
                        end
                    else
                        failures += 1
                        firstFailure = firstFailure or (path .. ": " .. tostring(lines or "no source"))
