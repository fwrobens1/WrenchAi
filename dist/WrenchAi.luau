local HttpService = game:GetService("HttpService")
local Compat = __require("compat")
local Util = __require("util")

local Config = {}
local FOLDER = "WrenchAi"
local FILE = FOLDER .. "/config.json"

-- The endpoint this project shipped with first; saved installs still point at
-- it, so rewrite that exact pair once instead of leaving people on a dead API.
local RETIRED_BASE_URL = "https://api.refuseless.com/v1"
local RETIRED_MODEL = "glm-5.3-abliterated"

Config.Defaults = {
    baseURL = "https://api.reflection.ai/openai/v1",
    model = "Beam-1.0-501B-A23B",
    apiKey = "",
    temperature = 0.7,
    maxTokens = 16000,
    maxSteps = 12,
    maxToolChars = 9000,
    autoApproveScripts = false,
    cobaltURL = "https://raw.githubusercontent.com/Wortexios/CobaltSpy/refs/heads/main/Cobalt",
    dexURL = "https://github.com/Tesker-103/DexRecontinued/releases/latest/download/out.lua",
    extraSystemPrompt = "",
}

function Config.Path()
    return FILE
end

function Config.CanPersist()
    return Compat.Has("writefile")
end

local function merge(target, source)
    for key, value in pairs(source) do
        local default = target[key]
        if default ~= nil and type(default) == type(value) then
            target[key] = value
        end
    end
end

