        Font = Theme.fontCode,
        TextSize = 10,
        TextColor3 = Theme.muted,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Text = argsText,
    }, bodyHolder)

    local expanded = false
    local function setExpanded(value)
        expanded = value
        bodyHolder.Visible = value
        if value then
            task.defer(function()
                task.wait()
                card.Size = UDim2.new(1, -6, 0, 34 + bodyHolder.AbsoluteSize.Y + 8)
            end)
        else
            card.Size = UDim2.new(1, -6, 0, 32)
        end
    end
    header.MouseButton1Click:Connect(function()
        setExpanded(not expanded)
        self:ScrollToBottom()
    end)

    local cardApi = {}
    local ui = self
    function cardApi:Finish(ok, resultText, seconds)
        local status = ok and "ok" or "error"
        title.Text = "["
            .. (ok and "OK" or "ERR")
            .. "] "
            .. name
            .. " - "
            .. status
            .. " - "
            .. Util.FormatSeconds(seconds or 0)
        title.TextColor3 = ok and Theme.ok or Theme.err
        body.Text = "args:\n"
            .. Util.Truncate(argsText or "{}", 800)
            .. "\n\nresult:\n"
            .. Util.Truncate(resultText or "", 3000)
        if not ok then
            setExpanded(true)
        end
        ui:ScrollToBottom()
    end
    function cardApi:Expand()
        setExpanded(true)
    end

    self:ScrollToBottom()
    return cardApi
end

function UI:AskApproval(spec, isCancelled)
    local state = { done = false, allow = false, always = false }
    self.pendingApproval = state

    if not self.root.Visible then
        self.root.Visible = true
        self.fab.Visible = false
    end

    local row = self:NewRow()
    local card = create("Frame", {
        BackgroundColor3 = Theme.panel,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, row)
    withCorner(card, 10)
    withStroke(card, Theme.warn, 1, 0.4)
    withPadding(card, 10, 12, 10, 12)
    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, card)

    local title = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 14),
        Font = Theme.fontBold,
        TextSize = 12,
        TextColor3 = Theme.warn,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Permission - " .. tostring(spec.title or "Run code"),
    }, card)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Theme.font,
        TextSize = 11,
        TextColor3 = Theme.text,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Text = tostring(spec.description or ""),
    }, card)

    local codeScroll = create("ScrollingFrame", {
        BackgroundColor3 = Theme.code,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 140),
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.border,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, card)
    withCorner(codeScroll, 6)
    withPadding(codeScroll, 6, 8, 6, 8)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Theme.fontCode,
        TextSize = 11,
        TextColor3 = Theme.text,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Text = tostring(spec.code or ""),
    }, codeScroll)

    local buttons = create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
    }, card)
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, buttons)

    local function decisionButton(text, color, order, callback)
        local button = create("TextButton", {
            Size = UDim2.new(0.32, -4, 1, 0),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Text = text,
            Font = Theme.fontBold,
            TextSize = 11,
            TextColor3 = Theme.text,
            AutoButtonColor = false,
            LayoutOrder = order,
        }, buttons)
        withCorner(button, 8)
        button.MouseButton1Click:Connect(function()
            if not state.done then
                callback()
            end
        end)
        return button
    end

    local function finish(allow, always)
        if state.done then
            return
        end
        state.done = true
        state.allow = allow
        state.always = always
        title.Text = allow and "Approved - Run code" or "Denied - Run code"
        title.TextColor3 = allow and Theme.ok or Theme.err
        for _, child in ipairs(buttons:GetChildren()) do
            if child:IsA("TextButton") then
                child.Active = false
                child.TextTransparency = 0.5
            end
        end
        self:SetStatus(allow and "Approved" or "Denied", allow and Theme.ok or Theme.err)
        self:ScrollToBottom()
    end

    decisionButton("Run", Theme.accent, 1, function()
        finish(true, false)
    end)
    decisionButton("Always", Theme.panelAlt, 2, function()
        finish(true, true)
    end)
    decisionButton("Deny", Color3.fromRGB(92, 34, 40), 3, function()
        finish(false, false)
    end)

    self:SetStatus("Waiting for approval", Theme.warn)
    self:ScrollToBottom()

    while not state.done do
        if isCancelled and isCancelled() then
            finish(false, false)
        end
        task.wait(0.1)
    end

    self.pendingApproval = nil
    return state.allow, state.always
end

return UI

end
__modules["util"] = function()
local Util = {}

function Util.Trim(text)
    return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

function Util.Clamp(value, low, high)
    if value < low then
        return low
    end
    if value > high then
        return high
    end
    return value
end

function Util.Truncate(value, maxChars)
    local text = tostring(value)
    if #text <= maxChars then
        return text
    end
    return text:sub(1, maxChars) .. "\n... [truncated " .. tostring(#text - maxChars) .. " chars]"
end

function Util.FormatSeconds(seconds)
    if seconds < 1 then
        return string.format("%dms", math.floor(seconds * 1000 + 0.5))
    end
    return string.format("%.1fs", seconds)
end

function Util.Copy(source)
    local target = {}
    for key, value in pairs(source) do
        target[key] = value
    end
    return target
end

function Util.Count(source)
    local count = 0
    for _ in pairs(source) do
        count += 1
    end
    return count
end

function Util.Lines(text)
    local lines = {}
    local position = 1
    text = tostring(text or "")
    while position <= #text do
        local newline = text:find("\n", position, true)
        if newline then
            table.insert(lines, text:sub(position, newline - 1))
            position = newline + 1
        else
            table.insert(lines, text:sub(position))
            break
        end
    end
    if #lines == 0 then
        table.insert(lines, "")
    end
    return lines
end

function Util.SafeCall(fn, ...)
    if type(fn) ~= "function" then
        return false, "not a function"
    end
    local results = table.pack(pcall(fn, ...))
    if not results[1] then
        return false, results[2]
    end
    return true, table.unpack(results, 2, results.n)
end

function Util.RunWithTimeout(seconds, fn)
    local finished = false
    local succeeded = false
    local result = nil
    task.spawn(function()
        succeeded, result = pcall(fn)
        finished = true
    end)
    local deadline = os.clock() + seconds
    while not finished and os.clock() < deadline do
        task.wait(0.05)
    end
    if not finished then
        return false, "timed out after " .. tostring(seconds) .. "s"
    end
    if not succeeded then
        return false, tostring(result)
    end
    return true, result
end

function Util.ErrorText(err)
    if type(err) == "string" then
        return err
    end
    local ok, text = pcall(tostring, err)
    return ok and text or "unknown error"
end

return Util

end
